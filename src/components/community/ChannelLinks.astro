---
import type { Locale } from '../../i18n/config';
import { getVisibleChannels } from '../../config/ecosystem';

interface Props {
  locale: Locale;
  variant?: 'cards' | 'compact';
}

const { locale, variant = 'cards' } = Astro.props;
const channels = getVisibleChannels();
---

{channels.length > 0 && (
  <div class:list={['channel-links', `channel-links--${variant}`]} aria-label={locale === 'it' ? 'Canali pubblici GVibeDev' : 'GVibeDev public channels'}>
    {channels.map((channel) => (
      <a
        class="channel-link"
        href={channel.url!}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="social"
        data-analytics-channel={channel.id}
      >
        <span class="channel-link__label">{channel.label}</span>
        {variant === 'cards' && (
          <span class="channel-link__description">
            {locale === 'it' ? channel.descriptionIt : channel.description}
          </span>
        )}
        <span class="channel-link__arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
)}

<style>
  .channel-links--cards { display:grid; gap:.8rem; }
  .channel-links--cards .channel-link {
    display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.45rem 1rem;
    min-height:5.4rem; padding:1rem; border:1px solid var(--color-border);
    border-radius:var(--radius-md); background:var(--color-surface-1);
    color:var(--color-text); text-decoration:none;
  }
  .channel-links--cards .channel-link:hover,
  .channel-links--cards .channel-link:focus-visible { border-color:var(--color-blue-soft); }
  .channel-links--cards .channel-link__label {
    font-family:var(--font-mono); font-size:.82rem; font-weight:850;
    letter-spacing:.04em; text-transform:uppercase;
  }
  .channel-links--cards .channel-link__description {
    grid-column:1; color:var(--color-text-muted); line-height:1.6;
  }
  .channel-links--cards .channel-link__arrow {
    grid-column:2; grid-row:1 / span 2; color:var(--color-red-soft);
  }
  .channel-links--compact { display:flex; flex-wrap:wrap; gap:.35rem 1rem; }
  .channel-links--compact .channel-link {
    display:inline-flex; min-height:44px; align-items:center; gap:.35rem;
    color:var(--color-blue-soft); font-family:var(--font-mono);
    font-size:.72rem; font-weight:750; text-decoration:none;
  }
  .channel-links--compact .channel-link:hover,
  .channel-links--compact .channel-link:focus-visible { color:var(--color-text); }
  .channel-links--compact .channel-link__arrow { color:var(--color-red-soft); }
  @media (min-width:48rem) {
    .channel-links--cards { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
</style>
