---
type ActionType =
  | 'play'
  | 'download'
  | 'support'
  | 'wishlist'
  | 'buy'
  | 'follow-development'
  | 'github'
  | 'join-playtest'
  | 'kickstarter'
  | 'documentation'
  | 'tutorials'
  | 'changelog'
  | 'community'
  | 'cards'
  | 'decks'
  | 'maps';

interface DataAction {
  type: ActionType;
  label?: string;
  href: string;
  primary?: boolean;
  newTab?: boolean;
}

interface Props {
  links: {
    repositoryUrl?: string;
    launchUrl?: string;
    releaseUrl?: string;
    actions?: DataAction[];
  };
}

const { links } = Astro.props;

const defaultLabels: Record<ActionType, string> = {
  play: 'Play',
  download: 'Download',
  support: 'Support',
  wishlist: 'Wishlist',
  buy: 'Buy',
  'follow-development': 'Follow development',
  github: 'View on GitHub',
  'join-playtest': 'Join playtest',
  kickstarter: 'Back on Kickstarter',
  documentation: 'Documentation',
  tutorials: 'Tutorials',
  changelog: 'Changelog',
  community: 'Community',
  cards: 'Cards',
  decks: 'Decks',
  maps: 'Maps',
};

const legacy = [
  links.launchUrl && { label: 'Launch App', href: links.launchUrl, primary: true, newTab: true, type: 'play' as ActionType },
  links.repositoryUrl && { label: 'View on GitHub', href: links.repositoryUrl, primary: !links.launchUrl, newTab: true, type: 'github' as ActionType },
  links.releaseUrl && { label: 'Download release', href: links.releaseUrl, primary: false, newTab: true, type: 'download' as ActionType },
].filter(Boolean) as { label: string; href: string; primary: boolean; newTab: boolean; type: ActionType }[];

const configured = (links.actions ?? [])
  .filter((action) => Boolean(action.href))
  .map((action) => ({
    label: action.label ?? defaultLabels[action.type],
    href: action.href,
    primary: Boolean(action.primary),
    newTab: Boolean(action.newTab),
    type: action.type,
  }));

const seen = new Set<string>();
const actions = [...legacy, ...configured].filter((action) => {
  const key = `${action.label}|${action.href}`;
  if (seen.has(key)) return false;
  seen.add(key);
  return true;
});
---

{actions.length > 0 && (
  <div class="project-actions">
    {actions.map((action) => (
      <a
        class:list={['project-action', action.primary && 'project-action--primary']}
        href={action.href}
        target={action.newTab ? '_blank' : undefined}
        rel={action.newTab ? 'noopener noreferrer' : undefined}
        data-analytics-event="project-cta"
        data-analytics-action={action.type}
      >
        {action.label} {action.newTab && <span aria-hidden="true">↗</span>}
      </a>
    ))}
  </div>
)}

<style>
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .project-action {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.7rem 0.95rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background: var(--color-surface-2);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.055em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .project-action--primary {
    border-color: color-mix(in srgb, var(--color-blue-bright) 70%, var(--color-border));
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-blue) 78%, #fff 6%), var(--color-blue-deep));
  }

  .project-action span { color: var(--color-red-soft); }
  .project-action:hover { border-color: var(--color-blue-soft); }
</style>
