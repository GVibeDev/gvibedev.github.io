---
interface GalleryItem {
  src: string;
  thumb: string;
  alt: string;
  caption?: string;
}

interface Props {
  items: GalleryItem[];
  locale?: 'en' | 'it';
  eyebrow?: string;
  title?: string;
  intro?: string;
}

const {
  items,
  locale = 'en',
  eyebrow = locale === 'it' ? 'In sviluppo' : 'In development',
  title = locale === 'it' ? 'Schermate dalla build corrente.' : 'Screens from the current build.',
  intro = locale === 'it'
    ? 'Catture reali di sviluppo. Apri qualsiasi frame per ispezionare l’immagine completa.'
    : 'Real development captures. Click any frame to inspect the full image.',
} = Astro.props;

const openLabel = locale === 'it' ? 'Apri' : 'Open';
const closeLabel = locale === 'it' ? 'Chiudi' : 'Close';
const dialogLabel = locale === 'it' ? 'Screenshot del progetto ingrandito' : 'Expanded project screenshot';
---

{items.length > 0 && (
  <section class="project-gallery" aria-labelledby="gallery-title">
    <div class="project-gallery__heading">
      <div>
        <span class="project-gallery__eyebrow">{eyebrow}</span>
        <h2 id="gallery-title">{title}</h2>
      </div>
      <p>{intro}</p>
    </div>

    <div class="project-gallery__grid">
      {items.map((item, index) => (
        <figure class:list={['gallery-card', index === 0 && 'gallery-card--wide']}>
          <a
            class="gallery-card__open"
            href={item.src}
            data-gallery-open
            data-full={item.src}
            data-alt={item.alt}
            data-caption={item.caption ?? ''}
          >
            <img
              src={item.thumb}
              alt={item.alt}
              width="960"
              height="540"
              loading="lazy"
              decoding="async"
            />
            <span class="gallery-card__inspect" aria-hidden="true">{openLabel} ↗</span>
          </a>
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </div>

    <dialog class="gallery-dialog" data-gallery-dialog aria-label={dialogLabel}>
      <div class="gallery-dialog__chrome">
        <button type="button" data-gallery-close aria-label={closeLabel}>{closeLabel} ×</button>
      </div>
      <img data-gallery-image alt="" />
      <p data-gallery-caption></p>
    </dialog>
  </section>
)}

<script>
  const dialog = document.querySelector('[data-gallery-dialog]');
  const image = dialog?.querySelector('[data-gallery-image]');
  const caption = dialog?.querySelector('[data-gallery-caption]');
  const closeButton = dialog?.querySelector('[data-gallery-close]');

  if (
    dialog instanceof HTMLDialogElement &&
    image instanceof HTMLImageElement &&
    caption instanceof HTMLElement
  ) {
    document.querySelectorAll('[data-gallery-open]').forEach((trigger) => {
      trigger.addEventListener('click', (event) => {
        if (!(trigger instanceof HTMLAnchorElement)) return;
        event.preventDefault();

        image.src = trigger.dataset.full ?? trigger.href;
        image.alt = trigger.dataset.alt ?? '';
        caption.textContent = trigger.dataset.caption ?? '';
        dialog.showModal();
      });
    });

    closeButton?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      image.removeAttribute('src');
      image.alt = '';
      caption.textContent = '';
    });
  }
</script>

<style>
  .project-gallery {
    display: grid;
    gap: 2rem;
  }

  .project-gallery__heading {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .project-gallery__eyebrow {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .project-gallery h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.7rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .project-gallery__heading > p {
    max-width: 37rem;
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .project-gallery__grid {
    display: grid;
    gap: 1rem;
  }

  .gallery-card {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .gallery-card__open {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
  }

  .gallery-card__open:hover {
    border-color: var(--color-blue);
  }

  .gallery-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .gallery-card__inspect {
    position: absolute;
    right: 0.7rem;
    bottom: 0.7rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background: rgba(2,3,5,0.86);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  figcaption {
    color: var(--color-text-subtle);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .gallery-dialog {
    width: min(96vw, 96rem);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    overflow: auto;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text);
    background: var(--color-bg-deep);
    box-shadow: 0 30px 120px rgba(0,0,0,0.75);
  }

  .gallery-dialog::backdrop {
    background: rgba(0,0,0,0.84);
    backdrop-filter: blur(5px);
  }

  .gallery-dialog__chrome {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    padding: 0.65rem;
    background: linear-gradient(var(--color-bg-deep), rgba(2,3,5,0.82));
  }

  .gallery-dialog button {
    min-height: 42px;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    background: var(--color-surface-2);
    font-family: var(--font-mono);
    font-weight: 800;
    cursor: pointer;
  }

  .gallery-dialog > img {
    display: block;
    width: 100%;
    height: auto;
  }

  .gallery-dialog > p {
    margin: 0;
    padding: 1rem 1.2rem 1.3rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .project-gallery__heading {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
      gap: 2rem;
    }

    .project-gallery__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-card--wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 70rem) {
    .project-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .gallery-card--wide {
      grid-column: span 2;
    }
  }
</style>
