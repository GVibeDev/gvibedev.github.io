---
interface Requirement {
  label: string;
  detail: string;
  scope: 'core' | 'generation';
  required: boolean;
}

interface InstallStep {
  title: string;
  body: string;
  code?: string;
}

interface Props {
  platforms: string[];
  category?: string;
  requirements: Requirement[];
  guide?: {
    title: string;
    intro?: string;
    warning?: string;
    steps: InstallStep[];
  };
}

const { platforms, category, requirements, guide } = Astro.props;
const coreRequirements = requirements.filter((item) => item.scope === 'core');
const generationRequirements = requirements.filter((item) => item.scope === 'generation');
---

<section class="tool-setup" aria-labelledby="tool-setup-title">
  <div class="tool-setup__heading">
    <span>Setup / dependencies</span>
    <h2 id="tool-setup-title">Know what the tool needs before you install it.</h2>
    <p>
      Sprite Studio can be used as a production workflow, while local AI generation adds a separate WanGP runtime stack.
      The two layers are documented independently so the Python environment is not hidden behind a generic “install” button.
    </p>
  </div>

  <div class="tool-setup__facts">
    {category && (
      <div>
        <span>Category</span>
        <strong>{category}</strong>
      </div>
    )}
    {platforms.length > 0 && (
      <div>
        <span>Platform</span>
        <strong>{platforms.join(' · ')}</strong>
      </div>
    )}
    <div>
      <span>Public package</span>
      <strong>Not published yet</strong>
    </div>
  </div>

  <div class="tool-setup__requirements">
    <section>
      <div class="tool-setup__subheading">
        <span>Core</span>
        <h3>Sprite Studio</h3>
      </div>
      <div class="dependency-list">
        {coreRequirements.map((item) => (
          <article class="dependency-card">
            <div>
              <strong>{item.label}</strong>
              <span>{item.required ? 'Required' : 'Optional'}</span>
            </div>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section>
      <div class="tool-setup__subheading">
        <span>Local generation</span>
        <h3>WanGP bridge</h3>
      </div>
      <div class="dependency-list">
        {generationRequirements.map((item) => (
          <article class="dependency-card dependency-card--generation">
            <div>
              <strong>{item.label}</strong>
              <span>{item.required ? 'Required for generation' : 'Optional'}</span>
            </div>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  {guide && (
    <div class="install-guide">
      <div class="install-guide__heading">
        <span>Validated development setup</span>
        <h2>{guide.title}</h2>
        {guide.intro && <p>{guide.intro}</p>}
      </div>

      {guide.warning && (
        <aside class="python-warning" aria-label="Python version warning">
          <strong>Python version matters.</strong>
          <p>{guide.warning}</p>
        </aside>
      )}

      <ol class="install-steps">
        {guide.steps.map((step) => (
          <li>
            <div class="install-step__number" aria-hidden="true"></div>
            <div class="install-step__content">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {step.code && <pre><code>{step.code}</code></pre>}
            </div>
          </li>
        ))}
      </ol>

      <p class="install-guide__footnote">
        This is the configuration validated for the GVibeDev development machine. It documents a known-good environment,
        not a claim that WanGP can only run with these exact versions. The final Sprite Studio installer/start command will
        be added when the first public repository and release are published.
      </p>
    </div>
  )}
</section>

<style>
  .tool-setup {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .tool-setup__heading,
  .install-guide__heading {
    display: grid;
    gap: 0.8rem;
    max-width: 58rem;
  }

  .tool-setup__heading > span,
  .install-guide__heading > span,
  .tool-setup__subheading > span {
    color: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .tool-setup h2,
  .install-guide h2 {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .tool-setup__heading p,
  .install-guide__heading p,
  .install-guide__footnote {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .tool-setup__facts {
    display: grid;
    gap: 0.75rem;
  }

  .tool-setup__facts > div {
    display: grid;
    gap: 0.4rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
  }

  .tool-setup__facts span {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tool-setup__requirements {
    display: grid;
    gap: 2rem;
  }

  .tool-setup__requirements > section { display: grid; gap: 1rem; }

  .tool-setup__subheading { display: grid; gap: 0.35rem; }
  .tool-setup__subheading h3 {
    margin: 0;
    font-size: 1.5rem;
  }

  .dependency-list { display: grid; gap: 0.75rem; }

  .dependency-card {
    display: grid;
    gap: 0.65rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
  }

  .dependency-card--generation {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-blue) 7%, transparent), transparent 60%),
      var(--color-surface-1);
  }

  .dependency-card > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .dependency-card > div > span {
    color: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dependency-card p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .install-guide {
    display: grid;
    gap: 1.5rem;
    padding-top: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid var(--color-border);
  }

  .python-warning {
    display: grid;
    gap: 0.5rem;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-red-bright) 55%, var(--color-border));
    border-left-width: 3px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-red-deep) 14%, var(--color-surface-1));
  }

  .python-warning strong { color: var(--color-red-soft); }
  .python-warning p { margin: 0; color: var(--color-text-muted); line-height: 1.65; }

  .install-steps {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: setup-step;
  }

  .install-steps li {
    counter-increment: setup-step;
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
  }

  .install-step__number::before {
    display: grid;
    width: 2.2rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--color-blue);
    border-radius: 999px;
    color: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    content: counter(setup-step, decimal-leading-zero);
  }

  .install-step__content { min-width: 0; }
  .install-step__content h3 { margin: 0 0 0.55rem; font-size: 1.05rem; }
  .install-step__content p { margin: 0; color: var(--color-text-muted); line-height: 1.65; }

  pre {
    max-width: 100%;
    margin: 0.85rem 0 0;
    padding: 0.9rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-deep);
  }

  code {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    white-space: pre;
  }

  .install-guide__footnote {
    padding: 1rem;
    border-left: 2px solid var(--color-border-strong);
    font-size: 0.88rem;
  }

  @media (min-width: 48rem) {
    .tool-setup__facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tool-setup__requirements { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
