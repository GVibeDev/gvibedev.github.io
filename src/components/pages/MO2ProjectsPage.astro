---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';
import ProjectCard from '../cards/ProjectCard.astro';
import type { Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

const projects = (await getCollection('projects'))
  .filter((project) => project.data.section === 'biggitykot')
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const profiles = [
  { label: 'pizza-990', href: 'https://github.com/pizza-990' },
  { label: 'MROctopusII', href: 'https://github.com/MROctopusII' },
];

const copy = locale === 'it'
  ? {
      description: 'Mo2 Projects raccoglie giochi, esperimenti e piccoli progetti software con una propria identità visuale.',
      eyebrow: 'Canale laterale / esperimenti indipendenti',
      intro: 'Giochi, esperimenti e piccoli progetti interattivi raccolti in un canale separato, con un’identità visiva propria.',
      profiles: 'Profili GitHub',
      showcaseEyebrow: 'Finestre di progetto',
      showcaseTitle: 'Dentro i progetti.',
      showcaseIntro: 'Screenshot reali dei progetti pubblicati o in sviluppo.',
      launch: 'Apri',
      repository: 'Repository',
      screenshot: 'Screenshot',
    }
  : {
      description: 'Mo2 Projects collects games, experiments and compact software projects with its own visual identity.',
      eyebrow: 'Side channel / independent experiments',
      intro: 'Games, experiments and compact interactive projects collected in a separate channel with its own visual identity.',
      profiles: 'GitHub profiles',
      showcaseEyebrow: 'Project windows',
      showcaseTitle: 'Inside the projects.',
      showcaseIntro: 'Real screenshots from published and in-development projects.',
      launch: 'Open',
      repository: 'Repository',
      screenshot: 'Screenshot',
    };

const showcaseSlugs = new Set(['wartanks', 'half-life-weapon-checker', 'team-io']);
const showcaseProjects = projects.filter((project) => showcaseSlugs.has(project.data.slug) && project.data.gallery.length > 0);

const italianCaptions: Record<string, string[]> = {
  wartanks: [
    'Configurazione del giocatore con colore personalizzato del carro e scelta dello stile di movimento.',
    'Un carro attivo sul campo di battaglia browser.',
  ],
  'half-life-weapon-checker': [
    'Il checker separa le tre campagne supportate di Half-Life.',
  ],
  'team-io': [
    'Configurazione del match con preset bot, modalità a obiettivi e pratica/tutorial.',
    'Arena di pratica con squadre rosse e blu, icone arma e HUD.',
  ],
};

const captionFor = (slug: string, index: number, fallback?: string) =>
  locale === 'it' ? (italianCaptions[slug]?.[index] ?? fallback ?? '') : (fallback ?? '');
---

<BaseLayout title="Mo2 Projects" description={copy.description} locale={locale}>
  <div class="mo2-page">
    <section class="mo2-hero">
      <Container>
        <div class="mo2-hero__copy">
          <span class="mo2-eyebrow">{copy.eyebrow}</span>
          <h1>Mo2 Projects</h1>
          <p>{copy.intro}</p>

          <div class="mo2-profiles" aria-label={copy.profiles}>
            {profiles.map((profile) => (
              <a href={profile.href} target="_blank" rel="noopener noreferrer">
                <span>{profile.label}</span>
                <strong>GitHub ↗</strong>
              </a>
            ))}
          </div>
        </div>

        <div class="mo2-signal" aria-hidden="true"><span></span><span></span><span></span></div>

        <div class="mo2-grid">
          {projects.map((project) => <ProjectCard project={project} featured={project.data.featured} locale={locale} />)}
        </div>
      </Container>
    </section>

    {showcaseProjects.length > 0 && (
      <section class="mo2-showcase">
        <Container>
          <div class="mo2-showcase__heading">
            <div>
              <span class="mo2-eyebrow">{copy.showcaseEyebrow}</span>
              <h2>{copy.showcaseTitle}</h2>
            </div>
            <p>{copy.showcaseIntro}</p>
          </div>

          <div class="mo2-windows">
            {showcaseProjects.map((project) => (
              <article class="mo2-window">
                <header class="mo2-window__bar">
                  <div>
                    <span class="mo2-window__dot"></span>
                    <strong>{project.data.title}</strong>
                  </div>
                  <div class="mo2-window__actions">
                    {project.data.links.launchUrl && (
                      <a href={project.data.links.launchUrl} target="_blank" rel="noopener noreferrer">{copy.launch} ↗</a>
                    )}
                    {project.data.links.repositoryUrl && (
                      <a href={project.data.links.repositoryUrl} target="_blank" rel="noopener noreferrer">{copy.repository} ↗</a>
                    )}
                  </div>
                </header>

                <div class="mo2-window__shots">
                  {project.data.gallery.map((item, index) => (
                    <figure>
                      <a href={item.src} target="_blank" rel="noopener noreferrer">
                        <img src={item.src} alt={item.alt} width="1200" height="800" loading="lazy" decoding="async" />
                      </a>
                      <figcaption>
                        <span>{copy.screenshot} {String(index + 1).padStart(2, '0')}</span>
                        {captionFor(project.data.slug, index, item.caption) && <p>{captionFor(project.data.slug, index, item.caption)}</p>}
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </Container>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .mo2-page {
    --aero-blue: #1f87c9;
    --aero-blue-deep: #0d4f86;
    --aero-cyan: #7ed7ff;
    --aero-glass: rgba(210, 239, 255, .54);
    --aero-glass-strong: rgba(232, 247, 255, .72);
    --aero-line: rgba(255, 255, 255, .72);
    --aero-edge: rgba(30, 98, 145, .56);
    --aero-text: #123148;
    --aero-muted: #345b75;
    --aero-green: #7fba35;
    --color-text: var(--aero-text);
    --color-text-muted: var(--aero-muted);
    --color-text-subtle: #56758a;
    --color-border: rgba(56, 121, 164, .42);
    --color-border-strong: rgba(27, 100, 151, .72);
    --color-surface-1: rgba(235, 249, 255, .68);
    --color-surface-2: rgba(210, 240, 255, .74);
    --color-bg-deep: #d8eef9;
    --color-blue-soft: #0e73b5;
    --color-blue-bright: #1794d4;
    --color-red-soft: #5c7b8f;
    --color-red-bright: #7fba35;
    --mo2-title-font: "Segoe UI", "Trebuchet MS", Arial, sans-serif;
    color: var(--aero-text);
    background:
      radial-gradient(circle at 18% 8%, rgba(255,255,255,.9), transparent 22rem),
      radial-gradient(circle at 82% 18%, rgba(72,176,226,.3), transparent 28rem),
      linear-gradient(180deg, #bfe7fb 0%, #7fc6e9 38%, #d8f3ff 100%);
  }

  .mo2-hero,
  .mo2-showcase { padding-block: clamp(3rem, 8vw, 7rem); }

  .mo2-hero {
    min-height: 70vh;
    background:
      radial-gradient(ellipse at 50% -5%, rgba(255,255,255,.95), transparent 32rem),
      linear-gradient(180deg, rgba(63,164,216,.18), rgba(255,255,255,.08));
  }

  .mo2-hero__copy {
    display: grid;
    gap: 1.15rem;
    max-width: 70rem;
    padding: clamp(1.2rem, 2.5vw, 2rem);
    border: 1px solid var(--aero-line);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(255,255,255,.72), rgba(198,234,249,.43));
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.95),
      inset 0 -1px 0 rgba(58,123,164,.18),
      0 14px 34px rgba(22,77,112,.18);
    backdrop-filter: blur(16px) saturate(135%);
  }

  .mo2-eyebrow {
    color: #0a68a4;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .mo2-hero h1,
  .mo2-showcase h2 {
    margin: 0;
    font-family: var(--mo2-title-font);
    color: #123d5b;
    font-weight: 300;
    letter-spacing: -.045em;
    text-shadow: 0 1px 0 rgba(255,255,255,.95);
  }

  .mo2-hero h1 {
    max-width: 12ch;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: .94;
  }

  .mo2-hero__copy > p {
    max-width: 54rem;
    margin: 0;
    color: var(--aero-muted);
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: clamp(1.05rem, 1rem + .3vw, 1.3rem);
    line-height: 1.65;
  }

  .mo2-profiles { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .35rem; }

  .mo2-profiles a {
    display: grid;
    gap: .12rem;
    min-width: 10rem;
    padding: .72rem .95rem;
    border: 1px solid rgba(28,103,151,.55);
    border-radius: 7px;
    color: #163b53;
    background: linear-gradient(180deg, rgba(255,255,255,.92), rgba(186,228,247,.72));
    box-shadow: inset 0 1px 0 #fff, 0 2px 6px rgba(41,91,122,.14);
    text-decoration: none;
    transition: filter .15s ease, transform .15s ease;
  }

  .mo2-profiles a:hover,
  .mo2-profiles a:focus-visible {
    filter: saturate(1.12) brightness(1.03);
    transform: translateY(-1px);
  }

  .mo2-profiles span { color: #466a81; font-family: "Segoe UI", Arial, sans-serif; font-size: .72rem; }
  .mo2-profiles strong { color: #0b6fac; font-family: "Segoe UI", Arial, sans-serif; font-size: .74rem; font-weight: 600; }

  .mo2-signal {
    display: grid;
    grid-template-columns: 1fr 4rem .65rem;
    gap: .55rem;
    margin-block: clamp(2rem, 5vw, 4rem);
  }
  .mo2-signal span { height: 2px; background: rgba(255,255,255,.85); box-shadow: 0 1px 0 rgba(31,102,148,.24); }
  .mo2-signal span:nth-child(2) { background: rgba(31,135,201,.62); }
  .mo2-signal span:nth-child(3) { background: var(--aero-green); }

  .mo2-grid { display: grid; gap: 1rem; }

  .mo2-showcase {
    border-top: 1px solid rgba(255,255,255,.7);
    background: linear-gradient(180deg, rgba(235,249,255,.34), rgba(120,196,232,.2));
  }

  .mo2-showcase__heading { display: grid; gap: 1rem; margin-bottom: 2rem; }
  .mo2-showcase h2 { margin-top: .45rem; font-size: clamp(2rem, 5vw, 4rem); line-height: 1; }
  .mo2-showcase__heading > p { max-width: 34rem; margin: 0; color: var(--aero-muted); line-height: 1.65; }

  .mo2-windows { display: grid; gap: clamp(1.25rem, 3vw, 2rem); }

  .mo2-window {
    overflow: hidden;
    border: 1px solid rgba(32,103,148,.58);
    border-radius: 11px;
    background: rgba(230,247,255,.56);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.95),
      0 18px 44px rgba(23,79,112,.2);
    backdrop-filter: blur(18px) saturate(145%);
  }

  .mo2-window__bar {
    display: flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .7rem .9rem;
    border-bottom: 1px solid rgba(38,104,145,.48);
    background:
      linear-gradient(180deg, rgba(255,255,255,.9), rgba(173,218,240,.76) 48%, rgba(123,190,224,.72) 49%, rgba(196,230,246,.82));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.95);
  }

  .mo2-window__bar > div { display: flex; align-items: center; gap: .55rem; }
  .mo2-window__bar strong { font-family: "Segoe UI", Arial, sans-serif; color: #15384f; font-size: .9rem; font-weight: 600; text-shadow: 0 1px 0 #fff; }

  .mo2-window__dot {
    width: .68rem;
    height: .68rem;
    border-radius: 50%;
    background: linear-gradient(180deg, #dff5ff, #4aa8d5);
    border: 1px solid rgba(29,92,129,.48);
    box-shadow: inset 0 1px 0 #fff;
  }

  .mo2-window__actions { flex-wrap: wrap; justify-content: flex-end; }
  .mo2-window__actions a { color: #0b69a3; font-family: "Segoe UI", Arial, sans-serif; font-size: .72rem; font-weight: 600; text-decoration: none; }
  .mo2-window__actions a:hover,
  .mo2-window__actions a:focus-visible { color: #4f8d1b; }

  .mo2-window__shots {
    display: flex;
    gap: .85rem;
    padding: .9rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-color: #4b9dcb rgba(255,255,255,.35);
  }

  .mo2-window figure {
    flex: 0 0 min(86vw, 46rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(41,105,146,.4);
    border-radius: 7px;
    background: rgba(255,255,255,.72);
    scroll-snap-align: start;
    box-shadow: inset 0 1px 0 #fff, 0 4px 12px rgba(33,88,119,.12);
  }

  .mo2-window figure > a { display: grid; min-height: 18rem; place-items: center; background: rgba(242,250,255,.72); }
  .mo2-window img { display: block; width: 100%; max-height: 34rem; object-fit: contain; }

  .mo2-window figcaption {
    display: grid;
    gap: .35rem;
    padding: .72rem .82rem .82rem;
    border-top: 1px solid rgba(48,110,148,.34);
    background: linear-gradient(180deg, rgba(255,255,255,.78), rgba(215,239,250,.68));
  }

  .mo2-window figcaption span { color: #0d70ae; font-family: "Segoe UI", Arial, sans-serif; font-size: .68rem; font-weight: 600; }
  .mo2-window figcaption p { margin: 0; color: #42657b; font-size: .84rem; line-height: 1.45; }

  :global(.mo2-page .project-card--biggitykot h3) {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #133c56;
    font-weight: 400;
    letter-spacing: -.025em;
  }

  @media (min-width: 40rem) { .mo2-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .mo2-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .mo2-showcase__heading { grid-template-columns: minmax(0, 1fr) minmax(22rem, .65fr); align-items: end; gap: 2rem; }
    .mo2-showcase__heading > p { justify-self: end; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mo2-profiles a { transition: none; }
    .mo2-profiles a:hover { transform: none; }
  }
</style>
