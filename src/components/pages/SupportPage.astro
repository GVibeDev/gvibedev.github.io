---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../ui/Container.astro';
import SupportCta from '../system/SupportCta.astro';
import type { Locale } from '../../i18n/config';
import { getSupportCopy } from '../../i18n/support';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSupportCopy(locale);
const title = locale === 'it' ? 'Supporta GVibeDev' : 'Support GVibeDev';
const description =
  locale === 'it'
    ? 'Supporto volontario allo sviluppo indipendente di giochi, strumenti e progetti creativi GVibeDev.'
    : 'Voluntary support for the independent development of GVibeDev games, tools and creative projects.';
---

<BaseLayout title={title} description={description} locale={locale}>
  <div class="support-page">
    <section class="support-hero">
      <Container>
        <div class="support-hero__grid">
          <div class="support-copy">
            <span class="eyebrow">{copy.eyebrow}</span>
            <h1>{copy.title}</h1>
            <p class="lead">{copy.lead}</p>
            <p>{copy.body}</p>
            <SupportCta locale={locale} />
          </div>

          <aside>
            <span class="eyebrow">{copy.transparencyTitle}</span>
            <p>{copy.transparencyBody}</p>
          </aside>
        </div>
      </Container>
    </section>

    <section class="support-secondary">
      <Container>
        <article>
          <span class="eyebrow">{copy.alternativeTitle}</span>
          <p>{copy.alternativeBody}</p>
        </article>
      </Container>
    </section>
  </div>
</BaseLayout>

<style>
  .support-page { color: var(--color-text); background: var(--color-bg); }
  .support-hero { padding-block: clamp(2.5rem, 7vw, 6rem); border-bottom: 1px solid var(--color-border); background: var(--color-bg-deep); }
  .support-hero__grid { display: grid; gap: 2rem; align-items: end; }
  .support-copy { display: grid; gap: 1rem; max-width: 58rem; }
  .eyebrow { color: var(--color-blue-soft); font-family: var(--font-mono); font-size: .72rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  h1 { max-width: 12ch; margin: 0; font-size: clamp(2.8rem, 8vw, 7rem); line-height: .9; letter-spacing: -.06em; }
  p { margin: 0; color: var(--color-text-muted); line-height: 1.8; }
  .lead { color: var(--color-text); font-size: clamp(1.08rem, 1rem + .35vw, 1.35rem); }
  aside, .support-secondary article { display: grid; gap: .8rem; padding: 1.2rem; border: 1px solid var(--color-border); background: var(--color-surface-1); }
  .support-secondary { padding-block: var(--section-space); }
  .support-secondary article { max-width: 58rem; }
  @media (min-width: 60rem) {
    .support-hero__grid { grid-template-columns: minmax(0, 1.35fr) minmax(18rem, .55fr); gap: 4rem; }
  }
</style>
