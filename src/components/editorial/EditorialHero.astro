---
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data } = project;
---

<header class="editorial-hero">
  <div class="editorial-hero__copy">
    <p class="editorial-hero__eyebrow">{data.editorialCategory ?? 'Narrative project'}</p>
    <h1>{data.title}</h1>
    {data.subtitle && <p class="editorial-hero__subtitle">{data.subtitle}</p>}
    <p class="editorial-hero__summary">{data.summary}</p>

    <div class="editorial-hero__meta" aria-label="Project status">
      {data.status && <span>{data.status}</span>}
      {data.editorialAvailability && <span>{data.editorialAvailability}</span>}
    </div>

    {data.documents.length > 0 && (
      <div class="editorial-hero__actions">
        <a href="#preview-library" class="editorial-hero__primary">Read the preview</a>
        <a href="#world">Enter the world</a>
      </div>
    )}
  </div>

  {data.heroImage && (
    <figure class="editorial-hero__cover">
      <img src={data.heroImage} alt={data.heroAlt ?? ''} width="1024" height="1536" decoding="async" />
    </figure>
  )}
</header>

<style>
  .editorial-hero { display: grid; gap: clamp(2rem, 6vw, 5rem); align-items: center; padding-block: clamp(3rem, 8vw, 7rem); }
  .editorial-hero__copy { display: grid; gap: 1.15rem; }
  .editorial-hero__eyebrow { margin: 0; color: var(--editorial-accent); font-family: var(--font-mono); font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0; max-width: 9ch; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(4rem, 12vw, 9rem); font-weight: 500; line-height: .82; letter-spacing: -.055em; }
  .editorial-hero__subtitle { margin: 0; color: var(--editorial-accent-soft); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.65rem, 4vw, 3.2rem); letter-spacing: .08em; text-transform: uppercase; }
  .editorial-hero__summary { max-width: 44rem; margin: .35rem 0 0; color: var(--color-text-muted); font-size: clamp(1.08rem, 1rem + .45vw, 1.4rem); line-height: 1.75; }
  .editorial-hero__meta { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .5rem; }
  .editorial-hero__meta span { padding: .42rem .65rem; border: 1px solid color-mix(in srgb, var(--editorial-accent) 42%, var(--color-border)); border-radius: 999px; color: var(--color-text-muted); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .05em; }
  .editorial-hero__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .8rem; }
  .editorial-hero__actions a { padding: .82rem 1rem; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); color: var(--color-text); font-family: var(--font-mono); font-size: .76rem; font-weight: 800; letter-spacing: .05em; text-decoration: none; text-transform: uppercase; }
  .editorial-hero__actions .editorial-hero__primary { border-color: color-mix(in srgb, var(--editorial-accent) 65%, var(--color-border)); background: color-mix(in srgb, var(--editorial-accent) 14%, var(--color-surface-1)); }
  .editorial-hero__cover { position: relative; margin: 0; justify-self: center; width: min(100%, 34rem); }
  .editorial-hero__cover::before { position: absolute; inset: 8% -7% -5% 8%; z-index: -1; background: radial-gradient(circle, color-mix(in srgb, var(--editorial-accent) 18%, transparent), transparent 66%); content: ''; filter: blur(22px); }
  .editorial-hero__cover img { display: block; width: 100%; height: auto; border: 1px solid color-mix(in srgb, var(--editorial-accent) 38%, var(--color-border)); box-shadow: 0 2.4rem 5rem rgba(0,0,0,.42); }
  @media (min-width: 60rem) { .editorial-hero { grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .8fr); } }
  @media (max-width: 59.99rem) { .editorial-hero__copy { order: 1; } .editorial-hero__cover { order: 2; width: min(86vw, 30rem); } }
</style>
