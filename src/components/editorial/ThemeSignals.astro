---
interface Props { themes: string[]; }
const { themes } = Astro.props;
---

{themes.length > 0 && (
  <section class="theme-signals" aria-labelledby="theme-signals-title">
    <p>Signals</p>
    <h2 id="theme-signals-title">Themes running through the preview.</h2>
    <ul>
      {themes.map((theme) => <li>{theme}</li>)}
    </ul>
  </section>
)}

<style>
  .theme-signals { display: grid; gap: 1.1rem; padding-block: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--color-border); }
  .theme-signals > p { margin: 0; color: var(--editorial-accent); font-family: var(--font-mono); font-size: .7rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  h2 { margin: 0; max-width: 16ch; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 5vw, 4rem); font-weight: 500; line-height: 1; }
  ul { display: flex; flex-wrap: wrap; gap: .6rem; margin: .8rem 0 0; padding: 0; list-style: none; }
  li { padding: .55rem .78rem; border: 1px solid color-mix(in srgb, var(--editorial-accent) 30%, var(--color-border)); border-radius: 999px; color: var(--color-text-muted); font-family: var(--font-mono); font-size: .73rem; }
</style>
