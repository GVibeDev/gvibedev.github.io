---
import Container from '../ui/Container.astro';
import MainNav from './MainNav.astro';
import MobileNav from './MobileNav.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import type { Locale } from '../../i18n/config';
import { getNavigationPath } from '../../i18n/config';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
---

<header class="site-header">
  <Container class="site-header__inner">
    <a class="brand" href={getNavigationPath('/', locale)} aria-label="G Vibe Dev — Home">
      <img src="/assets/brand/gvibe-wordmark.webp" alt="G Vibe Dev" width="1200" height="392" />
    </a>

    <div class="site-header__desktop">
      <MainNav locale={locale} pathname={pathname} />
      <LanguageSwitch locale={locale} pathname={pathname} />
    </div>

    <div class="site-header__mobile">
      <LanguageSwitch locale={locale} pathname={pathname} />
      <MobileNav locale={locale} pathname={pathname} />
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 82%, transparent);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(14px);
  }

  :global(.site-header__inner) {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    flex: 0 1 auto;
    align-items: center;
    width: clamp(8.2rem, 15vw, 11.5rem);
    min-height: 44px;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .site-header__desktop {
    display: none;
    align-items: center;
    gap: .8rem;
  }

  .site-header__mobile {
    display: flex;
    align-items: center;
    gap: .55rem;
  }

  @media (min-width: 60rem) {
    .site-header__desktop { display: flex; }
    .site-header__mobile { display: none; }
  }
</style>
