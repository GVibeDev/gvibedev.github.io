---
import type { Locale } from '../../i18n/config';
import { getEquivalentPath } from '../../i18n/config';
import { getArenaRubraShared } from '../../i18n/arena-rubra';

interface Props {
  currentSlug?: string;
  locale?: Locale;
}

const { currentSlug, locale = 'en' } = Astro.props;
const { relatedProjects } = getArenaRubraShared(locale);

const copy = locale === 'it'
  ? { aria: 'Progetti collegati ad Arena Rubra', current: 'Corrente', explore: 'Esplora →' }
  : { aria: 'Arena Rubra related projects', current: 'Current', explore: 'Explore →' };

function localizedHref(href: string) {
  if (locale !== 'it') return href;
  return getEquivalentPath(href, 'it') ?? href;
}
---

<div class="arena-ecosystem" aria-label={copy.aria}>
  {relatedProjects.map((project) => (
    currentSlug === project.slug ? (
      <div class="arena-ecosystem__card arena-ecosystem__card--current" aria-current="page">
        <span>{project.label} · {copy.current}</span>
        <strong>{project.title}</strong>
        <p>{project.body}</p>
      </div>
    ) : (
      <a class="arena-ecosystem__card" href={localizedHref(project.href)}>
        <span>{project.label}</span>
        <strong>{project.title}</strong>
        <p>{project.body}</p>
        <small>{copy.explore}</small>
      </a>
    )
  ))}
</div>

<style>
  .arena-ecosystem { display: grid; gap: .8rem; }
  .arena-ecosystem__card { display: grid; gap: .55rem; padding: 1rem; border: 1px solid var(--tabletop-line, var(--color-border)); color: var(--color-text); background: rgba(9,9,8,.72); text-decoration: none; }
  a.arena-ecosystem__card:hover { border-color: var(--tabletop-gold, var(--color-blue-soft)); }
  .arena-ecosystem__card--current { background: rgba(200,155,88,.08); }
  .arena-ecosystem__card span, .arena-ecosystem__card small { color: var(--tabletop-gold, var(--color-blue-soft)); font-family: var(--font-mono); font-size: .65rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .arena-ecosystem__card strong { font-size: 1rem; }
  .arena-ecosystem__card p { margin: 0; color: var(--color-text-muted); font-size: .86rem; line-height: 1.55; }
  @media (min-width: 48rem) { .arena-ecosystem { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
