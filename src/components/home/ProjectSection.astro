---
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../cards/ProjectCard.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
  projects: CollectionEntry<'projects'>[];
  variant?: 'default' | 'biggitykot';
}

const {
  id,
  eyebrow,
  title,
  description,
  projects,
  variant = 'default',
} = Astro.props;
---

<section class:list={['project-section', variant === 'biggitykot' && 'project-section--biggitykot']} id={id}>
  <Container>
    <SectionHeading eyebrow={eyebrow} title={title} description={description} />
    <div class="project-section__grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Container>
</section>

<style>

  .project-section {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-border);
  }

  .project-section--biggitykot {
    --color-surface-1: rgba(235, 249, 255, .72);
    --color-surface-2: rgba(208, 237, 250, .78);
    --color-border: rgba(42, 110, 153, .4);
    --color-border-strong: rgba(22, 93, 141, .68);
    --color-blue-soft: #0e73b5;
    --color-blue-bright: #1794d4;
    --color-red-soft: #577a91;
    --color-red-bright: #7fba35;
    --color-text: #15384f;
    --color-text-muted: #45687f;
    --mo2-title-font: "Segoe UI", "Trebuchet MS", Arial, sans-serif;
    background:
      radial-gradient(circle at 14% 0%, rgba(255,255,255,.9), transparent 22rem),
      radial-gradient(circle at 92% 18%, rgba(72,176,226,.28), transparent 26rem),
      linear-gradient(180deg, #c9ecfb 0%, #91d0ed 52%, #d8f3ff 100%);
    border-top-color: rgba(255,255,255,.76);
  }

  .project-section--biggitykot :global(.section-heading h2) {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #163d57;
    font-weight: 300;
    letter-spacing: -.045em;
    text-shadow: 0 1px 0 #fff;
  }

  .project-section--biggitykot :global(.section-heading__eyebrow) {
    color: #0b6fab;
  }

  .project-section--biggitykot :global(.project-card--biggitykot h3) {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #143c56;
    font-weight: 400;
    letter-spacing: -.025em;
  }

  .project-section__grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .project-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .project-section__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
