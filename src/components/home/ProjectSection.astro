---
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../cards/ProjectCard.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  description: string;
  projects: CollectionEntry<'projects'>[];
  variant?: 'default' | 'biggitykot';
}

const {
  id,
  eyebrow,
  title,
  description,
  projects,
  variant = 'default',
} = Astro.props;
---

<section class:list={['project-section', variant === 'biggitykot' && 'project-section--biggitykot']} id={id}>
  <Container>
    <div class:list={['project-section__shell', variant === 'biggitykot' && 'project-section__shell--biggitykot']}>
      <SectionHeading eyebrow={eyebrow} title={title} description={description} />
      <div class="project-section__grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </Container>
</section>

<style>
  .project-section {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-border);
  }

  .project-section__shell {
    position: relative;
  }

  .project-section--biggitykot {
    position: relative;
    overflow: clip;
    background:
      linear-gradient(180deg, rgba(8, 21, 40, 0.12), rgba(8, 21, 40, 0.42)),
      url('/assets/projects/mo2-aero-clouds-bg.png') center center / cover no-repeat,
      #74a7d6;
  }

  .project-section--biggitykot::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.18), transparent 30%),
      linear-gradient(180deg, rgba(255,255,255,0.08), transparent 42%);
    content: '';
    pointer-events: none;
  }

  .project-section__shell--biggitykot {
    padding: clamp(1.3rem, 2vw, 1.9rem);
    border: 1px solid rgba(255, 255, 255, 0.54);
    border-radius: 1.65rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.14)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.04));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.58),
      0 24px 60px rgba(8, 27, 56, 0.16),
      0 8px 20px rgba(8, 27, 56, 0.12);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
  }

  .project-section__shell--biggitykot :global(.section-heading) {
    margin-bottom: clamp(1.5rem, 2.8vw, 2.35rem);
  }

  .project-section__shell--biggitykot :global(.section-heading__eyebrow) {
    color: rgba(8, 21, 40, 0.74);
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-weight: 700;
  }

  .project-section__shell--biggitykot :global(.section-heading h2) {
    color: #081528;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-weight: 700;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.36);
  }

  .project-section__shell--biggitykot :global(.section-heading__row > p) {
    color: rgba(8, 21, 40, 0.78);
  }

  .project-section__grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .project-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .project-section__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
