---
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../cards/ProjectCard.astro';
import type { Locale } from '../../i18n/config';
import { getNavigationPath } from '../../i18n/config';
import { getCorePageCopy } from '../../i18n/core-pages';

interface Props {
  projects: CollectionEntry<'projects'>[];
  locale?: Locale;
}

const { projects, locale = 'en' } = Astro.props;
const copy = getCorePageCopy(locale).home.featured;
---

<section class="featured" id="projects">
  <Container>
    <SectionHeading
      eyebrow={copy.eyebrow}
      title={copy.title}
      description={copy.description}
    />
    <div class="featured__grid">
      {projects.map((project) => <ProjectCard project={project} featured />)}
    </div>
    <a class="featured__all" href={getNavigationPath('/projects/', locale)}>{copy.all}</a>
  </Container>
</section>

<style>
  .featured {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-border);
  }

  .featured__grid {
    display: grid;
    gap: 1rem;
  }

  .featured__all {
    display: inline-flex;
    margin-top: 1.4rem;
    color: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .featured__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
