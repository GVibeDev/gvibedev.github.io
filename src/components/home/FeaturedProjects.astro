---
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../cards/ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="featured" id="projects">
  <Container>
    <SectionHeading
      eyebrow="Selected work"
      title="Projects worth opening first."
      description="A cross-section of the workshop: a playable system, a production tool, and an evolving narrative world."
    />
    <div class="featured__grid">
      {projects.map((project) => <ProjectCard project={project} featured />)}
    </div>
    <a class="featured__all" href="/projects/">Browse all projects →</a>
  </Container>
</section>

<style>
  .featured {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-border);
  }

  .featured__grid {
    display: grid;
    gap: 1rem;
  }

  .featured__all {
    display: inline-flex;
    margin-top: 1.4rem;
    color: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .featured__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
