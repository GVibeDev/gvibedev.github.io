---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { siteConfig } from '../../config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <Container>
    <div class="hero__intro">
      <div class="hero__copy">
        <p class="hero__eyebrow">Independent digital workshop</p>
        <h1 id="hero-title">Ideas become things here.</h1>
        <p class="hero__lead">
          Games, tools, worlds and experiments built with AI-assisted development — with design, iteration, testing and human decisions left visible.
        </p>
        <div class="hero__actions">
          <Button href="#projects">Explore projects</Button>
          <Button href={siteConfig.github} variant="secondary" external>GitHub</Button>
        </div>
      </div>

      <div class="hero__principles" aria-label="Working principles">
        <span>AI_ASSISTED ≠ AUTOPILOT</span>
        <p>design / iterate / test / verify / ship</p>
      </div>
    </div>

    <figure class="hero__visual">
      <img
        src="/assets/home/hero-gvibedev.webp"
        alt="A person relaxing at a retro computer displaying the G Vibe Dev logo"
        width="1672"
        height="857"
        fetchpriority="high"
      />
      <figcaption>
        <span>GVIBEDEV.CC</span>
        <span>BUILD_01 / HOME SHELL</span>
      </figcaption>
    </figure>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(4.25rem, 9vw, 8rem) clamp(4rem, 8vw, 7rem);
  }

  .hero::before {
    position: absolute;
    top: 2rem;
    left: 50%;
    width: min(78vw, 70rem);
    height: min(78vw, 70rem);
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-blue) 13%, transparent), transparent 64%);
    content: '';
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hero__intro {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2.2rem;
    margin-bottom: clamp(2.4rem, 5vw, 4rem);
  }

  .hero__copy {
    max-width: 850px;
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-red-bright);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    max-width: 10ch;
    font-size: clamp(3.2rem, 9vw, 7.8rem);
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .hero__lead {
    max-width: 64ch;
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.8rem;
  }

  .hero__principles {
    align-self: end;
    padding: 1rem 0 0 1rem;
    border-left: 1px solid var(--color-red);
    font-family: var(--font-mono);
  }

  .hero__principles span {
    color: var(--color-blue-soft);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .hero__principles p {
    margin: 0.35rem 0 0;
    color: var(--color-text-subtle);
    font-size: 0.7rem;
  }

  .hero__visual {
    position: relative;
    z-index: 1;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: #000;
    box-shadow: var(--shadow-lg);
  }

  .hero__visual::after {
    position: absolute;
    inset: 0;
    border: 1px solid color-mix(in srgb, var(--color-blue-bright) 16%, transparent);
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .hero__visual img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1672 / 857;
    object-fit: cover;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    padding: 0.75rem 0.9rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-subtle);
    background: var(--color-surface-1);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
  }

  @media (min-width: 60rem) {
    .hero__intro {
      grid-template-columns: minmax(0, 1.55fr) minmax(14rem, 0.45fr);
      align-items: end;
    }

    .hero__principles {
      justify-self: end;
      margin-bottom: 0.4rem;
    }
  }
</style>
