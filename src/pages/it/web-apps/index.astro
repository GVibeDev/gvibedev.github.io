---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import ProjectCard from '../../../components/cards/ProjectCard.astro';
import { getCorePageCopy } from '../../../i18n/core-pages';

const locale = 'it' as const;
const copy = getCorePageCopy(locale).webApps;

const apps = (await getCollection('projects'))
  .filter((project) => project.data.section === 'web-apps')
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const liveApps = apps.filter((project) => Boolean(project.data.links.launchUrl));
const projectPages = apps.filter((project) => project.data.pageReady);
---

<BaseLayout title={copy.title} description={copy.description} locale={locale}>
  <section class="webapps-index">
    <Container>
      <header class="webapps-index__hero">
        <span>{copy.eyebrow}</span>
        <h1>{copy.heading}</h1>
        <p>{copy.intro}</p>

        <div class="webapps-index__facts" aria-label={copy.factsLabel}>
          <div>
            <strong>{apps.length}</strong>
            <span>{copy.tracked}</span>
          </div>
          <div>
            <strong>{projectPages.length}</strong>
            <span>{copy.pages}</span>
          </div>
          <div>
            <strong>{liveApps.length}</strong>
            <span>{copy.runtimes}</span>
          </div>
        </div>
      </header>

      <div class="webapps-index__grid">
        {apps.map((app) => <ProjectCard project={app} featured={app.data.featured} />)}
      </div>

      <section class="runtime-policy" aria-labelledby="runtime-policy-title">
        <div>
          <span>{copy.policyEyebrow}</span>
          <h2 id="runtime-policy-title">{copy.policyTitle}</h2>
        </div>
        <div class="runtime-policy__copy">
          {copy.policyBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    </Container>
  </section>
</BaseLayout>

<style>
  .webapps-index {
    padding-block: clamp(3rem, 8vw, 7rem) var(--section-space);
  }

  .webapps-index__hero {
    display: grid;
    gap: 1rem;
    max-width: 62rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  .webapps-index__hero > span,
  .runtime-policy > div:first-child > span {
    color: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 8rem);
    line-height: 0.86;
    letter-spacing: -0.07em;
  }

  .webapps-index__hero > p {
    max-width: 56rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.3rem);
    line-height: 1.7;
  }

  .webapps-index__facts {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .webapps-index__facts > div {
    display: grid;
    gap: 0.25rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
  }

  .webapps-index__facts strong {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 1.45rem;
  }

  .webapps-index__facts span {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .webapps-index__grid {
    display: grid;
    gap: 1rem;
  }

  .runtime-policy {
    display: grid;
    gap: 1.5rem;
    margin-top: var(--section-space);
    padding-top: clamp(2rem, 5vw, 4rem);
    border-top: 1px solid var(--color-border);
  }

  .runtime-policy > div:first-child {
    display: grid;
    gap: 0.7rem;
  }

  .runtime-policy h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .runtime-policy__copy {
    display: grid;
    gap: 1rem;
    max-width: 54rem;
  }

  .runtime-policy__copy p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  @media (min-width: 40rem) {
    .webapps-index__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .webapps-index__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .runtime-policy {
      grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }
  }
</style>
