---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import LocalizedProjectBody from '../../../../components/project/LocalizedProjectBody.astro';

const locale = 'it' as const;
const project = (await getCollection('projects')).find(
  (entry) => entry.data.slug === 'manuale-llm',
);

if (!project) {
  throw new Error('Manuale LLM project data not found.');
}
---

<ProjectLayout project={project} locale={locale}>
  <LocalizedProjectBody slug="manuale-llm" locale={locale} />
</ProjectLayout>
