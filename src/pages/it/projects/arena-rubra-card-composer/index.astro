---
import { getCollection } from 'astro:content';
import ProjectLayout from '../../../../layouts/ProjectLayout.astro';
import LocalizedProjectBody from '../../../../components/project/LocalizedProjectBody.astro';

const locale = 'it' as const;
const project = (await getCollection('projects')).find(
  (entry) => entry.data.slug === 'arena-rubra-card-composer',
);

if (!project) {
  throw new Error('Arena Rubra Card Composer project data not found.');
}
---

<ProjectLayout project={project} locale={locale}>
  <LocalizedProjectBody slug="arena-rubra-card-composer" locale={locale} />
</ProjectLayout>
