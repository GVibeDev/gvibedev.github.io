---
import { getCollection } from 'astro:content';
import ArenaRubraDigitalLayout from '../../../../layouts/ArenaRubraDigitalLayout.astro';
import LocalizedProjectBody from '../../../../components/project/LocalizedProjectBody.astro';

const locale = 'it' as const;
const project = (await getCollection('projects')).find(
  (entry) => entry.data.slug === 'arena-rubra-digital',
);

if (!project) {
  throw new Error('Arena Rubra Digital project data not found.');
}
---

<ArenaRubraDigitalLayout project={project} locale={locale}>
  <LocalizedProjectBody slug="arena-rubra-digital" locale={locale} />
</ArenaRubraDigitalLayout>
