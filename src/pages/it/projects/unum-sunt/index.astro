---
import { getCollection } from 'astro:content';
import EditorialProjectLayout from '../../../../layouts/EditorialProjectLayout.astro';
import LocalizedProjectBody from '../../../../components/project/LocalizedProjectBody.astro';

const locale = 'it' as const;
const project = (await getCollection('projects')).find(
  (entry) => entry.data.slug === 'unum-sunt',
);

if (!project) {
  throw new Error('Unum Sunt project data not found.');
}
---

<EditorialProjectLayout project={project} locale={locale}>
  <LocalizedProjectBody slug="unum-sunt" locale={locale} />
</EditorialProjectLayout>
