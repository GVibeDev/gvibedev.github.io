---
import { getCollection } from 'astro:content';
import BoardGameProjectLayout from '../../../../layouts/BoardGameProjectLayout.astro';
import LocalizedProjectBody from '../../../../components/project/LocalizedProjectBody.astro';

const locale = 'it' as const;
const project = (await getCollection('projects')).find(
  (entry) => entry.data.slug === 'arena-rubra-board-game',
);

if (!project) {
  throw new Error('Arena Rubra Board Game project data not found.');
}
---

<BoardGameProjectLayout project={project} locale={locale}>
  <LocalizedProjectBody slug="arena-rubra-board-game" locale={locale} />
</BoardGameProjectLayout>
