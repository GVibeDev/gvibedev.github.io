---
import { getCollection } from 'astro:content';
import SpriteStudioProjectLayout from '../../../../layouts/SpriteStudioProjectLayout.astro';

const project = (await getCollection('projects')).find(
  (entry) => entry.data.slug === 'unum-sunt-sprite-studio',
);

if (!project) {
  throw new Error('Unum Sunt Sprite Studio project data not found.');
}
---

<SpriteStudioProjectLayout project={project} locale="it" />
