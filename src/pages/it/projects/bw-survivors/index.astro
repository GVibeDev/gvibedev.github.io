---
import { getCollection } from 'astro:content';
import BiggityKotProjectLayout from '../../../../layouts/BiggityKotProjectLayout.astro';
import LocalizedProjectBody from '../../../../components/project/LocalizedProjectBody.astro';

const locale = 'it' as const;
const project = (await getCollection('projects')).find(
  (entry) => entry.data.slug === 'bw-survivors',
);

if (!project) {
  throw new Error('B&W Survivors project data not found.');
}
---

<BiggityKotProjectLayout project={project} locale={locale}>
  <LocalizedProjectBody slug="bw-survivors" locale={locale} />
</BiggityKotProjectLayout>
