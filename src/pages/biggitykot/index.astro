---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import ProjectCard from '../../components/cards/ProjectCard.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.section === 'biggitykot')
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const profiles = [
  'https://github.com/pizza-990',
  'https://github.com/MROctopusII',
];
---

<BaseLayout
  title="MO2 Projects"
  description="MO2 Projects is a dedicated channel for playable experiments, games and compact software projects."
>
  <section class="bk-index">
    <Container>
      <div class="bk-index__hero bk-glass-panel">
        <span class="bk-index__eyebrow">MO2 Projects / independent experiments</span>
        <div class="bk-index__title-row">
          <h1>MO2 Projects.</h1>
          <div class="bk-index__profiles">
            {profiles.map((profile) => <a href={profile} target="_blank" rel="noreferrer">GitHub ↗</a>)}
          </div>
        </div>
        <p>
          A dedicated project channel for games, web experiments and compact software pieces. This variant shifts the
          whole MO2 area toward a Windows 7 inspired aero-glass atmosphere with soft contrast, framed screenshots and
          transparent panels.
        </p>
      </div>

      <div class="bk-index__rule" aria-hidden="true"><span></span><span></span><span></span></div>

      <div class="bk-index__grid">
        {projects.map((project) => <ProjectCard project={project} featured={project.data.featured} />)}
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .bk-index {
    min-height: 70vh;
    padding-block: clamp(3rem, 8vw, 7rem) var(--section-space);
    background:
      linear-gradient(180deg, rgba(7, 18, 36, 0.18), rgba(7, 18, 36, 0.56)),
      url('/assets/projects/mo2-aero-clouds-bg.png') center top / cover fixed no-repeat,
      #76a9d8;
    --mo2-ink: #081528;
    --mo2-ink-soft: rgba(8, 21, 40, 0.78);
    --mo2-line: rgba(255, 255, 255, 0.56);
  }

  .bk-glass-panel {
    border: 1px solid var(--mo2-line);
    border-radius: 1.6rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.16)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.05));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 24px 60px rgba(8, 27, 56, 0.18),
      0 8px 20px rgba(8, 27, 56, 0.12);
    backdrop-filter: blur(18px) saturate(130%);
    -webkit-backdrop-filter: blur(18px) saturate(130%);
  }

  .bk-index__hero {
    display: grid;
    gap: 1.2rem;
    max-width: 70rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
    padding: clamp(1.35rem, 2.4vw, 2rem);
  }

  .bk-index__eyebrow {
    color: var(--mo2-ink-soft);
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .bk-index__title-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: end;
    justify-content: space-between;
  }

  h1 {
    margin: 0;
    color: var(--mo2-ink);
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-size: clamp(3.5rem, 11vw, 8rem);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.065em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .bk-index__profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .bk-index__title-row a {
    margin-bottom: 0.2rem;
    padding: 0.74rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 999px;
    color: var(--mo2-ink);
    text-decoration: none;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.34);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.58);
  }

  .bk-index__title-row a:hover {
    background: rgba(255, 255, 255, 0.5);
    border-color: rgba(255, 255, 255, 0.9);
  }

  .bk-index__hero p {
    max-width: 56rem;
    margin: 0;
    color: rgba(8, 21, 40, 0.82);
    font-size: clamp(1.05rem, 1rem + 0.28vw, 1.24rem);
    line-height: 1.72;
  }

  .bk-index__rule {
    display: grid;
    grid-template-columns: 1fr 3rem 0.5rem;
    gap: 0.5rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .bk-index__rule span {
    height: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(255,255,255,0.82), rgba(122, 174, 231, 0.72));
    box-shadow: 0 1px 0 rgba(255,255,255,0.45);
  }

  .bk-index__grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .bk-index__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 70rem) {
    .bk-index__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
