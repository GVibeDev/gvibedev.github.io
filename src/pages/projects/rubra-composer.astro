---
const target = '/projects/rubra-packager/';
const canonical = new URL(target, Astro.site ?? Astro.url.origin);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <title>Rubra Packager â€” GVibeDev</title>
    <script is:inline>
      const target = '/projects/rubra-packager/';
      window.location.replace(target + window.location.search + window.location.hash);
    </script>
  </head>
  <body>
    <p>
      Rubra Packager has moved to
      <a href={target}>/projects/rubra-packager/</a>.
    </p>
  </body>
</html>