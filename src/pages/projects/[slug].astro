---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ToolProjectLayout from '../../layouts/ToolProjectLayout.astro';
import EditorialProjectLayout from '../../layouts/EditorialProjectLayout.astro';
import BiggityKotProjectLayout from '../../layouts/BiggityKotProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => project.data.pageReady)
    .map((project) => ({
      params: { slug: project.data.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const Layout = project.data.owner === 'biggitykot'
  ? BiggityKotProjectLayout
  : project.data.kind === 'tool'
    ? ToolProjectLayout
    : project.data.kind === 'world'
      ? EditorialProjectLayout
      : ProjectLayout;
---

<Layout project={project}>
  <Content />
</Layout>
