---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ToolProjectLayout from '../../layouts/ToolProjectLayout.astro';
import EditorialProjectLayout from '../../layouts/EditorialProjectLayout.astro';
import BiggityKotProjectLayout from '../../layouts/BiggityKotProjectLayout.astro';
import BoardGameProjectLayout from '../../layouts/BoardGameProjectLayout.astro';
import ArenaRubraDigitalLayout from '../../layouts/ArenaRubraDigitalLayout.astro';
import SpriteStudioProjectLayout from '../../layouts/SpriteStudioProjectLayout.astro';
import RubraPackagerProjectLayout from '../../layouts/RubraPackagerProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => project.data.pageReady)
    .map((project) => ({
      params: { slug: project.data.slug },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);

let Layout: any = ProjectLayout;

if (project.data.slug === 'arena-rubra-board-game') {
  Layout = BoardGameProjectLayout;
} else if (project.data.slug === 'arena-rubra-digital') {
  Layout = ArenaRubraDigitalLayout;
} else if (project.data.slug === 'unum-sunt-sprite-studio') {
  Layout = SpriteStudioProjectLayout;
} else if (project.data.slug === 'rubra-packager') {
  Layout = RubraPackagerProjectLayout;
} else if (project.data.owner === 'biggitykot') {
  Layout = BiggityKotProjectLayout;
} else if (project.data.kind === 'tool') {
  Layout = ToolProjectLayout;
} else if (project.data.kind === 'world') {
  Layout = EditorialProjectLayout;
}
---

<Layout project={project}>
  <Content />
</Layout>
