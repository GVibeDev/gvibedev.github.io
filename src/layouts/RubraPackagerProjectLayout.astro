<script is:inline src="https://static.itch.io/api.js"></script>
<script is:inline define:vars={{ itchUser, itchGame, itchFallbackPrice }}>
(() => {
  const buyButtons = Array.from(document.querySelectorAll('[data-rubra-itch-buy]'));
  if (!buyButtons.length || typeof Itch === 'undefined') return;

  const itchProduct = { user: itchUser, game: itchGame };

  buyButtons.forEach((buyButton) => {
    Itch.attachBuyButton(buyButton, itchProduct);
  });

  Itch.getGameData({
    ...itchProduct,
    onComplete: function(data) {
      if (!data || !data.price) return;

      buyButtons.forEach((buyButton) => {
        if (data.sale && data.original_price) {
          buyButton.textContent = `Get Rubra Packager — ${data.price}`;
          buyButton.setAttribute(
            'aria-label',
            `Get Rubra Packager on itch.io for ${data.price}, currently on sale`
          );
        } else {
          buyButton.textContent = `Get Rubra Packager — ${data.price}+`;
          buyButton.setAttribute(
            'aria-label',
            `Get Rubra Packager on itch.io — minimum price ${data.price || itchFallbackPrice}`
          );
        }
      });
    }
  });
})();
</script>

