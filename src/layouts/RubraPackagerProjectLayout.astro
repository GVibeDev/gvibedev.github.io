---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import ScreenshotCarousel from '../components/project/ScreenshotCarousel.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  locale?: 'en' | 'it';
}

const { project, locale = 'en' } = Astro.props;
const { data } = project;
const repositoryUrl = data.links.repositoryUrl ?? 'https://github.com/GVibeDev/Rubra-Packager';
const arenaRubraUrl = locale === 'it' ? '/it/projects/arena-rubra-digital/' : '/projects/arena-rubra-digital/';
const arenaProfileUrl = 'https://github.com/GVibeDev/Rubra-Packager/blob/main/profiles/arena-rubra.json';
const itchUrl = 'https://gvibedev.itch.io/rubra-packager';
const itchUser = 'gvibedev';
const itchGame = 'rubra-packager';
const itchFallbackPrice = '$3.99';

const copy = locale === 'it'
  ? {
      subtitle: 'Package. Build. Deploy.',
      status: 'v1.0.0 · disponibile su itch.io',
      repo: 'Repository GitHub',
      buyCta: 'Get Rubra Packager — $3.99+',
      buyAria: 'Acquista Rubra Packager su itch.io — prezzo minimo $3.99',
      buyMicrocopy: 'Checkout sicuro e download tramite itch.io. $3.99 minimo — puoi pagare di più se vuoi.',
      viewItch: 'Vedi Rubra Packager su itch.io',
      overviewEyebrow: 'Release engineering locale',
      overviewTitle: 'Dal sorgente alla release Windows: non soltanto HTML → EXE.',
      overviewBody: [
        'Rubra Packager è una workstation desktop Windows pensata per progetti locali fidati. Oltre a trasformare applicazioni web statiche/offline in EXE o APK, può partire direttamente dal codice sorgente di un’app Python, validarlo, preparare le dipendenze in uno staging isolato e costruire un artefatto Windows ONEFILE o ONEDIR.',
        'Quell’artefatto può poi passare a Setup Builder per diventare un vero installer Windows Inno Setup. Questa catena Python sorgente → EXE/ONEDIR → Setup è una delle caratteristiche centrali del progetto e lo distingue da un semplice convertitore HTML-to-EXE.',
        'Il progetto è nato come strumento interno per il workflow di GVibeDev e, dopo molte build reali, è stato separato in un prodotto autonomo con interfaccia, runtime di build privato, controlli di sicurezza e tooling di release dedicati.',
      ],
      features: [
        ['Projects', 'Registra i progetti web locali e conserva profilo, variante e metadati di packaging senza duplicare i sorgenti.'],
        ['Web Preflight', 'Controlla leggibilità UTF-8, riferimenti locali, file richiesti dal profilo e contenuti inclusi/esclusi prima della compilazione.'],
        ['Web → Windows', 'Confeziona applicazioni web statiche/offline come EXE Windows one-file tramite PyWebView e PyInstaller.'],
        ['Python → Windows', 'Parte dal codice sorgente Python e costruisce ONEFILE o ONEDIR, GUI o console, con icone, metadati, hidden imports, data files e dipendenze isolate.'],
        ['Web → Android', 'Prepara APK Android per progetti web statici supportati usando Node/npm, staging Capacitor-style e toolchain Gradle/Android.'],
        ['Setup Builder', 'Prende l’EXE ONEFILE o la cartella ONEDIR costruita e la trasforma in un installer Inno Setup con AppId stabile, shortcut e disinstallazione.'],
      ],
      pythonEyebrow: 'La caratteristica distintiva',
      pythonTitle: 'Da un progetto Python sorgente a EXE e Setup Windows.',
      pythonIntro: 'Il percorso Python non è un accessorio del convertitore web: è una pipeline separata. Rubra Packager usa un motore Python/PyInstaller privato, esegue un preflight dedicato e mantiene lo staging delle dipendenze separato dal runtime dell’app.',
      pythonSteps: [
        ['01 · Sorgente', 'Seleziona la cartella del progetto e l’entry point Python.'],
        ['02 · Preflight', 'Controlla entry point, sintassi, metadata delle dipendenze, hidden imports, data path e search path.'],
        ['03 · Build EXE', 'Scegli ONEFILE o ONEDIR, GUI o console, icona, versione, publisher e descrizione; PyInstaller produce l’artefatto Windows.'],
        ['04 · Setup', 'Passa l’EXE o la directory ONEDIR a Setup Builder e genera un installer Inno Setup con shortcut, AppId stabile e supporto alla disinstallazione.'],
      ],
      pythonFootnote: 'Setup Builder è volutamente un secondo stadio: non compila direttamente il sorgente Python, ma confeziona l’artefatto Windows già prodotto e testato. Per l’utente il workflow completo resta: sorgente Python → EXE/ONEDIR → Setup.',
      originEyebrow: 'Perché esiste “Arena Rubra” tra i profili?',
      originTitle: 'Rubra Packager nasce da un problema reale di Arena Rubra Digital.',
      originBody: [
        'Il primo workflow che ha portato alla nascita del packager era quello di Arena Rubra Digital: un gioco web offline con una libreria locale di asset ampia e con l’esigenza di distinguere pacchetti FULL e LITE senza perdere file realmente referenziati.',
        'Per questo la distribuzione include ancora un profilo Arena Rubra. Non è codice speciale nel motore: il sistema dei profili è data-driven e carica le stesse regole JSON usate anche da Generic Web Game e Generic HTML App.',
      ],
      originPoints: [
        'Il profilo Arena Rubra richiede index.html, usa orientamento landscape e cerca assets-manifest.json oppure assets/manifest.json.',
        'FULL non esclude cartelle di produzione e, per progetti compatibili, può tecnicamente funzionare anche fuori da Arena Rubra.',
        'LITE è invece calibrato sulla struttura del gioco: esclude cartelle tipiche di musica, video e artwork high-resolution. Su un’app diversa potrebbe rimuovere contenuti necessari.',
        'Per altri progetti è quindi preferibile partire da Generic Web Game o Generic HTML App. Il profilo Arena Rubra resta soprattutto un preset specifico e un esempio concreto dell’architettura profile-driven.',
        'I profili sono definiti in JSON nel sorgente; l’authoring di profili personalizzati non è ancora presentato come workflow end-user rifinito nella v1.0.0.',
      ],
      arenaCta: 'Scopri Arena Rubra Digital',
      profileSource: 'Vedi il profilo Arena Rubra',
      carouselEyebrow: 'Interfaccia reale',
      carouselTitle: 'La build v1.0.0 in uso.',
      carouselIntro: 'Schermate reali della build Windows corrente: registrazione progetti, preflight, packaging Windows, Python, Android e pagina About.',
      dependenciesEyebrow: 'Dipendenze e toolchain',
      dependenciesTitle: 'Installa solo ciò che serve al target che vuoi produrre.',
      dependenciesIntro: 'Rubra Packager separa l’app desktop dal motore di build. Il runtime Python privato vive sotto %LOCALAPPDATA%\\RubraPackager\\runtime\\.venv; le toolchain esterne restano dipendenze esplicite del sistema.',
      sourceOnly: 'Per eseguire Rubra Packager direttamente dal repository serve Python 3.11 o superiore. Lo script di bootstrap crea o ripara il runtime privato e installa pywebview, PyInstaller e Pillow.',
      setupOnly: 'Inno Setup 6 o 7 è necessario per Setup Builder e per costruire la release Setup di Rubra Packager. Se manca, l’app può proporre un bootstrap tramite winget, sempre dopo un’azione esplicita.',
      androidOnly: 'Per Android servono JDK 17+, Android SDK e Node.js/npm. Android Studio è il percorso più semplice per installare e mantenere l’SDK.',
      dependencyLinks: 'Download ufficiali',
      splashEyebrow: 'Identità del prodotto',
      splashTitle: 'Package. Protect. Deploy.',
      safetyEyebrow: 'Limiti e sicurezza',
      safetyTitle: 'È un tool di build, non una sandbox.',
      safetyBody: 'Quando abiliti installazione o build delle dipendenze, il progetto selezionato può eseguire codice con i permessi del tuo utente Windows. Usa queste funzioni soltanto con sorgenti che conosci e di cui ti fidi.',
      safetyPoints: [
        'npm install, npm run build, pip install -r requirements.txt e pip install . possono eseguire codice controllato dal progetto.',
        'Il preflight Python non esegue l’entry point selezionato.',
        'Entry point, data path e search path Python sono confinati alla root del progetto; i percorsi che ne escono vengono rifiutati.',
        'L’API locale dell’interfaccia ascolta solo in loopback, usa un token casuale per ogni avvio e rifiuta origini browser esterne.',
        'Il sorgente Python non usa shell=True per i processi di build.',
        'Rubra Packager va eseguito come utente normale, non come Administrator.',
      ],
      limitsTitle: 'Cosa non fa la v1.0.0',
      limits: [
        'Non pacchettizza applicazioni macOS o Linux.',
        'Il packaging web è destinato ad applicazioni statiche/offline: backend server, SSR server e API runtime non vengono incorporati.',
        'Asset generati dinamicamente e nomi non rilevabili staticamente possono richiedere un manifest di progetto.',
        'La validazione Android v1 è orientata a build APK/device; pubblicazione sugli store e workflow di signing per distribuzione restano separati.',
        'Authenticode è opzionale e richiede una propria infrastruttura di certificati.',
        'Setup Builder, preso da solo, non compila il sorgente: nel workflow Python l’EXE/ONEDIR viene creato prima da Python → Windows e poi trasformato in installer.',
      ],
      distributionEyebrow: 'Distribuzione',
      distributionTitle: 'Sorgente pubblico su GitHub. Acquisto e download ufficiali su itch.io.',
      distributionBody: [
        'Il repository GitHub resta il riferimento pubblico per codice sorgente, documentazione, test, branding e strumenti necessari ad assemblare Rubra Packager. Gli artefatti compilati non vengono committati nel source tree.',
        'La distribuzione binaria ufficiale è ora attiva su itch.io: il checkout, la libreria dell’acquirente e i download di Setup/Portable sono gestiti direttamente dalla piattaforma. Una GitHub Release con binari testati resta prevista come canale aggiuntivo futuro.',
      ],
      buildTools: 'Per costruire Rubra Packager localmente, il repository fornisce build_release_windows.cmd: prepara il runtime, costruisce l’app ONEDIR, crea il Portable ZIP e compila il Setup Inno, quindi genera manifest e checksum SHA-256.',
      userGuide: 'Guida utente',
      building: 'Build dal sorgente',
      security: 'Security policy',
    }
  : {
      subtitle: 'Package. Build. Deploy.',
      status: 'v1.0.0 · available on itch.io',
      repo: 'GitHub repository',
      buyCta: 'Get Rubra Packager — $3.99+',
      buyAria: 'Get Rubra Packager on itch.io — minimum price $3.99',
      buyMicrocopy: 'Secure checkout and downloads via itch.io. $3.99 minimum — pay more if you wish.',
      viewItch: 'View Rubra Packager on itch.io',
      overviewEyebrow: 'Local release engineering',
      overviewTitle: 'From source to Windows release — not only HTML → EXE.',
      overviewBody: [
        'Rubra Packager is a Windows desktop release workshop for trusted local projects. Beyond turning offline/static web applications into EXE or APK builds, it can start directly from a Python application source tree, validate it, stage dependencies in isolation and build a Windows ONEFILE or ONEDIR artifact.',
        'That artifact can then be passed to Setup Builder and turned into a real Inno Setup Windows installer. This Python source → EXE/ONEDIR → Setup chain is a core part of the product and sets it apart from a narrow HTML-to-EXE converter.',
        'The project started as an internal GVibeDev release tool and, after repeated real-world builds, was separated into an independent product with its own interface, private build runtime, security gates and release tooling.',
      ],
      features: [
        ['Projects', 'Register local web projects once and keep profile, variant and packaging metadata without duplicating the source.'],
        ['Web Preflight', 'Check UTF-8 readability, local references, profile-required files and included/excluded content before packaging.'],
        ['Web → Windows', 'Package offline/static web applications as one-file Windows executables using PyWebView and PyInstaller.'],
        ['Python → Windows', 'Start from Python source and build ONEFILE or ONEDIR, GUI or console, with icons, metadata, hidden imports, data files and isolated dependencies.'],
        ['Web → Android', 'Build device-oriented Android APKs for supported static web projects through Node/npm, Capacitor-style staging and Gradle/Android tooling.'],
        ['Setup Builder', 'Take the built ONEFILE EXE or ONEDIR folder and turn it into an Inno Setup installer with stable AppId, shortcuts and uninstall support.'],
      ],
      pythonEyebrow: 'The differentiating workflow',
      pythonTitle: 'From a Python source project to Windows EXE and Setup.',
      pythonIntro: 'The Python path is not an add-on to the web converter: it is a separate pipeline. Rubra Packager uses a private Python/PyInstaller engine, runs a dedicated preflight and keeps dependency staging isolated from the application runtime.',
      pythonSteps: [
        ['01 · Source', 'Select the project folder and Python entry point.'],
        ['02 · Preflight', 'Check entry point, syntax, dependency metadata, hidden imports, data paths and search paths.'],
        ['03 · Build EXE', 'Choose ONEFILE or ONEDIR, GUI or console, icon, version, publisher and description; PyInstaller produces the Windows artifact.'],
        ['04 · Setup', 'Pass the EXE or ONEDIR folder to Setup Builder and generate an Inno Setup installer with shortcuts, stable AppId and uninstall support.'],
      ],
      pythonFootnote: 'Setup Builder is deliberately a second stage: it does not compile Python source directly, but packages the already-produced and tested Windows artifact. The complete user workflow is still source Python → EXE/ONEDIR → Setup.',
      originEyebrow: 'Why is there an “Arena Rubra” profile?',
      originTitle: 'Rubra Packager grew out of a real Arena Rubra Digital release problem.',
      originBody: [
        'The first workflow that drove the packager was Arena Rubra Digital: a large offline web game with a substantial local asset library and a need to separate FULL and LITE packages without silently dropping files that were actually referenced.',
        'That is why the distribution still includes an Arena Rubra profile. It is not special-case code in the engine: the profile system is data-driven and loads the same JSON rule structure used by Generic Web Game and Generic HTML App.',
      ],
      originPoints: [
        'The Arena Rubra profile requires index.html, assumes landscape orientation and looks for assets-manifest.json or assets/manifest.json.',
        'FULL excludes no production folders and can technically work with other compatible static applications.',
        'LITE is project-specific: it excludes common Arena Rubra music, video and high-resolution artwork paths. On another app those rules could remove required content.',
        'For unrelated projects, Generic Web Game or Generic HTML App is therefore the safer starting point. Arena Rubra remains a specific preset and a concrete example of the profile-driven architecture.',
        'Profiles are JSON-defined in the source tree; custom-profile authoring is not yet presented as a polished end-user workflow in v1.0.0.',
      ],
      arenaCta: 'Explore Arena Rubra Digital',
      profileSource: 'View the Arena Rubra profile',
      carouselEyebrow: 'Real interface',
      carouselTitle: 'The v1.0.0 build in use.',
      carouselIntro: 'Current Windows captures covering project registration, preflight, Windows, Python and Android packaging, plus the About workspace.',
      dependenciesEyebrow: 'Dependencies and toolchains',
      dependenciesTitle: 'Install only the toolchain required by the target you want to build.',
      dependenciesIntro: 'Rubra Packager separates the frozen desktop GUI from its private Python build engine. The private runtime lives under %LOCALAPPDATA%\\RubraPackager\\runtime\\.venv, while external platform toolchains remain explicit system dependencies.',
      sourceOnly: 'Running Rubra Packager directly from the source repository requires Python 3.11 or newer. The bootstrap helper creates or repairs the private runtime and installs pywebview, PyInstaller and Pillow.',
      setupOnly: 'Inno Setup 6 or 7 is required for Setup Builder and for building Rubra Packager’s Setup release. If it is missing, the application can offer an explicit winget bootstrap after user confirmation.',
      androidOnly: 'Android builds require JDK 17+, Android SDK and Node.js/npm. Android Studio is the simplest supported route for installing and maintaining the SDK.',
      dependencyLinks: 'Official downloads',
      splashEyebrow: 'Product identity',
      splashTitle: 'Package. Protect. Deploy.',
      safetyEyebrow: 'Limits and security',
      safetyTitle: 'It is a build tool, not a sandbox.',
      safetyBody: 'When dependency installation or source builds are enabled, the selected project can execute code with your Windows user permissions. Use those operations only for sources you know and trust.',
      safetyPoints: [
        'npm install, npm run build, pip install -r requirements.txt and pip install . can execute project-controlled code.',
        'Python preflight does not execute the selected entry point.',
        'Python entry points, data paths and search paths are confined to the selected project root; escaping paths are rejected.',
        'The local UI API is loopback-only, protected by a random per-launch token and rejects foreign browser origins.',
        'The Python source does not use shell=True for build execution.',
        'Rubra Packager should be run as a normal user, not as Administrator.',
      ],
      limitsTitle: 'What v1.0.0 does not do',
      limits: [
        'It does not package macOS or Linux desktop applications.',
        'Web packaging targets offline/static applications; server backends, SSR servers and runtime APIs are not bundled.',
        'Dynamically generated asset names that cannot be discovered statically may require a project manifest.',
        'The validated Android v1 scope is device-oriented APK production; store publishing and distribution-signing workflows remain separate.',
        'Authenticode signing is optional and requires your own certificate infrastructure.',
        'Setup Builder by itself does not compile source code: in the Python workflow, Python → Windows creates the EXE/ONEDIR first and Setup Builder packages that artifact afterward.',
      ],
      distributionEyebrow: 'Distribution',
      distributionTitle: 'Public source on GitHub. Official purchase and downloads on itch.io.',
      distributionBody: [
        'GitHub remains the public home for source code, documentation, tests, branding and the tooling required to assemble Rubra Packager. Compiled artifacts are intentionally kept out of the source tree.',
        'Official binary distribution is now active on itch.io: checkout, the buyer library and Setup/Portable downloads are handled directly by the platform. A GitHub Release with tested binaries remains planned as an additional future channel.',
      ],
      buildTools: 'To build Rubra Packager locally, the repository provides build_release_windows.cmd: it prepares the runtime, builds the ONEDIR application, creates the Portable ZIP and compiles the Inno Setup package, then writes the release manifest and SHA-256 checksums.',
      userGuide: 'User guide',
      building: 'Build from source',
      security: 'Security policy',
    };

const dependencies = [
  {
    name: 'Python 3.11+',
    scope: locale === 'it' ? 'Sorgente + motore di build privato' : 'Source + private build engine',
    body: copy.sourceOnly,
    href: 'https://www.python.org/downloads/windows/',
    label: 'python.org',
  },
  {
    name: 'Inno Setup 6 / 7',
    scope: 'Setup Builder',
    body: copy.setupOnly,
    href: 'https://jrsoftware.org/isdl.php',
    label: 'jrsoftware.org',
  },
  {
    name: 'JDK 17+',
    scope: 'Android',
    body: copy.androidOnly,
    href: 'https://adoptium.net/temurin/releases/?version=17',
    label: 'Eclipse Temurin',
  },
  {
    name: 'Android SDK',
    scope: 'Android',
    body: locale === 'it'
      ? 'Installa Android Studio e usa il suo SDK Manager, oppure i command-line tools ufficiali, per configurare SDK e piattaforme richieste.'
      : 'Install Android Studio and use its SDK Manager, or the official command-line tools, to configure the required SDK platforms and tools.',
    href: 'https://developer.android.com/studio',
    label: 'Android Developers',
  },
  {
    name: 'Node.js + npm',
    scope: 'Android / web source builds',
    body: locale === 'it'
      ? 'Necessari per il workflow Android e per progetti web che devono eseguire un build npm prima del packaging.'
      : 'Required by the Android workflow and by web projects that need an npm build step before packaging.',
    href: 'https://nodejs.org/en/download',
    label: 'nodejs.org',
  },
];

const docsBase = 'https://github.com/GVibeDev/Rubra-Packager/blob/main';
---

<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.summary}
  image={data.socialImage ?? data.cover}
  locale={locale}
>
  <div class="rubra-page">
    <section class="rubra-hero">
      <Container>
        <div class="rubra-hero__copy">
          <div class="rubra-kicker">Rubra Packager · {copy.status}</div>
          <h1>{data.title}</h1>
          <p class="rubra-subtitle">{copy.subtitle}</p>
          <div class="rubra-actions">
            <a class="rubra-button rubra-button--primary" href={repositoryUrl} target="_blank" rel="noreferrer">{copy.repo} ↗</a>
            <a class="rubra-button" href={`${docsBase}/docs/USER_GUIDE.md`} target="_blank" rel="noreferrer">{copy.userGuide} ↗</a>
          </div>

          <div class="rubra-purchase">
            <a
              id="rubra-packager-itch-buy"
              class="rubra-itch-buy"
              data-rubra-itch-buy
              href={itchUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={copy.buyAria}
            >
              {copy.buyCta}
            </a>
            <p>{copy.buyMicrocopy}</p>
            <a class="rubra-itch-link" href={itchUrl} target="_blank" rel="noopener noreferrer">{copy.viewItch} →</a>
          </div>
        </div>
      </Container>
    </section>

    {data.logo && (
      <section class="rubra-logo-strip" aria-label="Rubra Packager logo">
        <Container>
          <figure>
            <img src={data.logo} alt="Rubra Packager" width="2048" height="512" />
          </figure>
        </Container>
      </section>
    )}

    <section class="rubra-overview">
      <Container>
        <div class="rubra-section-heading">
          <span>{copy.overviewEyebrow}</span>
          <h2>{copy.overviewTitle}</h2>
        </div>

        <div class="rubra-overview__body">
          {copy.overviewBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="rubra-feature-grid">
          {copy.features.map(([title, body]) => (
            <article>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>

        <div class="rubra-python-pipeline">
          <div class="rubra-section-heading rubra-section-heading--inside">
            <span>{copy.pythonEyebrow}</span>
            <h2>{copy.pythonTitle}</h2>
            <p>{copy.pythonIntro}</p>
          </div>

          <ol class="rubra-pipeline-steps">
            {copy.pythonSteps.map(([title, body]) => (
              <li>
                <strong>{title}</strong>
                <p>{body}</p>
              </li>
            ))}
          </ol>

          <p class="rubra-pipeline-note">{copy.pythonFootnote}</p>
        </div>

        <article class="rubra-origin-card">
          <div>
            <span>{copy.originEyebrow}</span>
            <h2>{copy.originTitle}</h2>
            {copy.originBody.map((paragraph) => <p>{paragraph}</p>)}
          </div>

          <div class="rubra-origin-card__details">
            <ul>
              {copy.originPoints.map((point) => <li>{point}</li>)}
            </ul>
            <div class="rubra-origin-card__actions">
              <a class="rubra-button rubra-button--primary" href={arenaRubraUrl}>{copy.arenaCta} →</a>
              <a class="rubra-button" href={arenaProfileUrl} target="_blank" rel="noreferrer">{copy.profileSource} ↗</a>
            </div>
          </div>
        </article>
      </Container>
    </section>

    {data.gallery.length > 0 && (
      <section class="rubra-carousel-shell">
        <Container>
          <ScreenshotCarousel
            items={data.gallery}
            locale={locale}
            eyebrow={copy.carouselEyebrow}
            title={copy.carouselTitle}
            intro={copy.carouselIntro}
            ariaLabel={locale === 'it' ? 'Screenshot di Rubra Packager' : 'Rubra Packager screenshots'}
            dialogAriaLabel={locale === 'it' ? 'Screenshot Rubra Packager ingrandito' : 'Expanded Rubra Packager screenshot'}
          />
        </Container>
      </section>
    )}

    <section class="rubra-dependencies" id="requirements">
      <Container>
        <div class="rubra-section-heading">
          <span>{copy.dependenciesEyebrow}</span>
          <h2>{copy.dependenciesTitle}</h2>
          <p>{copy.dependenciesIntro}</p>
        </div>

        <div class="rubra-dependency-grid">
          {dependencies.map((dependency) => (
            <article>
              <div class="rubra-dependency__topline">
                <strong>{dependency.name}</strong>
                <span>{dependency.scope}</span>
              </div>
              <p>{dependency.body}</p>
              <a href={dependency.href} target="_blank" rel="noreferrer">{copy.dependencyLinks}: {dependency.label} ↗</a>
            </article>
          ))}
        </div>
      </Container>
    </section>

    {data.endcapImage && (
      <section class="rubra-splash">
        <Container>
          <div class="rubra-section-heading rubra-section-heading--compact">
            <span>{copy.splashEyebrow}</span>
            <h2>{copy.splashTitle}</h2>
          </div>
          <figure>
            <img src={data.endcapImage} alt={data.endcapAlt ?? 'Rubra Packager splash screen'} width="1672" height="941" loading="lazy" decoding="async" />
          </figure>
        </Container>
      </section>
    )}

    <section class="rubra-safety">
      <Container>
        <div class="rubra-safety__grid">
          <div class="rubra-warning">
            <span>{copy.safetyEyebrow}</span>
            <h2>{copy.safetyTitle}</h2>
            <p>{copy.safetyBody}</p>
            <ul>
              {copy.safetyPoints.map((point) => <li>{point}</li>)}
            </ul>
          </div>

          <div class="rubra-limits">
            <h3>{copy.limitsTitle}</h3>
            <ul>
              {copy.limits.map((limit) => <li>{limit}</li>)}
            </ul>
          </div>
        </div>
      </Container>
    </section>

    <section class="rubra-distribution">
      <Container>
        <div class="rubra-section-heading">
          <span>{copy.distributionEyebrow}</span>
          <h2>{copy.distributionTitle}</h2>
        </div>

        <div class="rubra-distribution__body">
          <div>
            {copy.distributionBody.map((paragraph) => <p>{paragraph}</p>)}
            <p>{copy.buildTools}</p>
          </div>

          <aside>
            <a
              id="rubra-packager-itch-buy-secondary"
              class="rubra-itch-buy rubra-itch-buy--compact"
              data-rubra-itch-buy
              href={itchUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={copy.buyAria}
            >
              {copy.buyCta}
            </a>
            <span class="rubra-distribution__itch-note">{copy.buyMicrocopy}</span>
