---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectGallery from '../components/project/ProjectGallery.astro';
import ProjectActions from '../components/project/ProjectActions.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
---

<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.summary}
  image={data.socialImage ?? data.cover}
>
  <ProjectHero project={project} />

  <section class="project-story">
    <Container>
      <div class="project-story__grid">
        <aside class="project-story__aside">
          <span class="project-story__eyebrow">Project note</span>
          <p>
            This page describes a live development project. Features, visuals and interface details can change as
            new baselines are tested and validated.
          </p>
          <ProjectActions links={data.links} />
        </aside>

        <article class="project-prose">
          <slot />
        </article>
      </div>
    </Container>
  </section>

  {data.gallery.length > 0 && (
    <section class="project-gallery-shell">
      <Container>
        <ProjectGallery items={data.gallery} />
      </Container>
    </section>
  )}

  {data.endcapImage && (
    <section class="project-endcap" aria-label={`${data.title} artwork`}>
      <Container>
        <figure>
          <img
            src={data.endcapImage}
            alt={data.endcapAlt ?? ''}
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </Container>
    </section>
  )}
</BaseLayout>

<style>
  .project-story {
    padding-block: var(--section-space);
  }

  .project-story__grid {
    display: grid;
    gap: 3rem;
  }

  .project-story__aside {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-1);
  }

  .project-story__eyebrow {
    color: var(--color-red-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .project-story__aside p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  :global(.project-prose) {
    max-width: 51rem;
  }

  :global(.project-prose h2) {
    margin: 0 0 1.2rem;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  :global(.project-prose h2:not(:first-child)) {
    margin-top: 4.5rem;
  }

  :global(.project-prose h3) {
    margin: 2.5rem 0 0.7rem;
    color: var(--color-blue-soft);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  :global(.project-prose p) {
    margin: 0 0 1.3rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 0.96rem + 0.15vw, 1.08rem);
    line-height: 1.8;
  }

  :global(.project-prose strong) {
    color: var(--color-text);
  }

  .project-gallery-shell {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-deep);
  }

  .project-endcap {
    padding-block: 0 var(--section-space);
    background: var(--color-bg-deep);
  }

  .project-endcap figure {
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .project-endcap img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 60rem) {
    .project-story__grid {
      grid-template-columns: 17rem minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 6rem);
      align-items: start;
    }

    .project-story__aside {
      position: sticky;
      top: 6.5rem;
    }
  }
</style>
