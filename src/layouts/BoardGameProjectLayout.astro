---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import ProjectGallery from '../components/project/ProjectGallery.astro';
import ArenaRubraFactionGrid from '../components/arena-rubra/ArenaRubraFactionGrid.astro';
import ArenaRubraEcosystemLinks from '../components/arena-rubra/ArenaRubraEcosystemLinks.astro';
import { getNavigationPath, type Locale } from '../i18n/config';
import { getProjectView } from '../i18n/projects-it';
import { getArenaRubraShared, getArenaRubraTabletopCopy } from '../i18n/arena-rubra';

interface Props {
  project: CollectionEntry<'projects'>;
  locale?: Locale;
}

const { project, locale = 'en' } = Astro.props;
const data = getProjectView(project, locale);
const arena = getArenaRubraShared(locale);
const copy = getArenaRubraTabletopCopy(locale);

const arenaRubraUniverse = arena.universe;
const arenaRubraCorePrinciples = arena.corePrinciples;
const arenaRubraMatchFlow = arena.matchFlow;
const arenaRubraSystems = arena.systems;
const arenaRubraTestingSummary = arena.testingSummary;
const arenaRubraTestAreas = arena.testAreas;

const facts = copy.facts;
const sampleCardAssets = [
  { src: '/assets/projects/arena-rubra-board-game/cards/varran.webp' },
  { src: '/assets/projects/arena-rubra-board-game/cards/adepto-fabeot.webp' },
  { src: '/assets/projects/arena-rubra-board-game/cards/predone-liberto.webp' },
];
const sampleCards = sampleCardAssets.map((asset, index) => ({
  ...asset,
  ...copy.sampleCards[index],
}));
const developmentStatus = copy.developmentStatus;
---

<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.summary}
  image={data.socialImage ?? data.cover}
  locale={locale}
>
  <div class="tabletop-page">
    <section class="tabletop-hero">
      <Container>
        <a class="tabletop-back" href={getNavigationPath('/worlds/', locale)}>{copy.back}</a>

        <div class="tabletop-hero__head">
          <div class="tabletop-hero__copy">
            <div class="tabletop-kicker">
              <span>{copy.kicker}</span>
              {data.status && <span>{data.status}</span>}
            </div>
            <h1>Arena Rubra</h1>
            <p>{data.summary}</p>
            <div class="tabletop-actions">
              <a class="tabletop-action tabletop-action--primary" href="#what-is-arena-rubra">{copy.explore}</a>
              <a class="tabletop-action" href={getNavigationPath('/projects/arena-rubra-digital/', locale)}>{copy.digitalProject}</a>
            </div>
          </div>

          <aside class="prototype-note" aria-label={copy.prototypeAria}>
            <span>{copy.prototypeEyebrow}</span>
            <strong>{copy.prototypeTitle}</strong>
            <p>{copy.prototypeBody}</p>
          </aside>
        </div>

        {data.heroImage && (
          <figure class="tabletop-hero__media">
            <img src={data.heroImage} alt={data.heroAlt ?? ''} width="1672" height="941" fetchpriority="high" />
            <figcaption>{copy.heroCaption}</figcaption>
          </figure>
        )}

        <div class="tabletop-facts" aria-label={copy.factsAria}>
          {facts.map(([label, value]) => (
            <div>
              <span>{label}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <section id="what-is-arena-rubra" class="tabletop-intro section-block">
      <Container>
        <div class="intro-grid">
          <div>
            <span class="eyebrow">{copy.introEyebrow}</span>
            <h2>{copy.introTitle}</h2>
          </div>
          <div class="intro-copy">
            <p>{arenaRubraUniverse.positioning}</p>
            <p>{copy.introBody[0]}</p>
            <p>{copy.introBody[1]}</p>
          </div>
        </div>
      </Container>
    </section>

    <section class="tabletop-system section-block">
      <Container>
        <div class="section-heading">
          <span>Plan / Position / Pressure</span>
          <h2>{copy.systemTitle}</h2>
        </div>
        <div class="pillar-grid">
          {arenaRubraCorePrinciples.map((pillar, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{pillar.label}</h3>
              <strong>{pillar.title}</strong>
              <p>{pillar.body}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="match-flow section-block">
      <Container>
        <div class="section-heading section-heading--compact">
          <span>{copy.matchEyebrow}</span>
          <h2>{copy.matchTitle}</h2>
        </div>
        <div class="flow-grid">
          {arenaRubraMatchFlow.map((item) => (
            <article>
              <span>{item.step}</span>
              <h3>{item.label}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="systems-section section-block">
      <Container>
        <div class="section-heading">
          <span>{copy.mechanicsEyebrow}</span>
          <h2>{copy.mechanicsTitle}</h2>
        </div>
        <div class="systems-grid">
          {arenaRubraSystems.map((system) => (
            <article>
              <h3>{system.title}</h3>
              <p>{system.body}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="tabletop-story section-block">
      <Container>
        <div class="tabletop-story__grid">
          <aside class="tabletop-story__aside">
            <span>{copy.disciplineEyebrow}</span>
            <strong>{copy.disciplineTitle}</strong>
            <p>{copy.disciplineBody}</p>
          </aside>
          <article class="tabletop-prose">
            <slot />
          </article>
        </div>
      </Container>
    </section>

    <section class="faction-section section-block">
      <Container>
        <div class="section-heading section-heading--compact">
          <span>{copy.factionsEyebrow}</span>
          <h2>{copy.factionsTitle}</h2>
        </div>
        <ArenaRubraFactionGrid locale={locale} />
      </Container>
    </section>

    <section class="testing-section section-block">
      <Container>
        <div class="testing-hero">
          <div class="testing-stat">
            <strong>{arenaRubraTestingSummary.stat}</strong>
            <span>{arenaRubraTestingSummary.statLabel}</span>
          </div>
          <div class="testing-copy">
            <span class="eyebrow">{copy.testingEyebrow}</span>
            <h2>{arenaRubraTestingSummary.headline}</h2>
            <p>{arenaRubraTestingSummary.body}</p>
            <blockquote>{arenaRubraTestingSummary.principle}</blockquote>
            <code>{arenaRubraTestingSummary.cycle}</code>
          </div>
        </div>
        <p class="testing-strapline">{arenaRubraTestingSummary.strapline}</p>
      </Container>
    </section>

    <section class="test-areas section-block">
      <Container>
        <div class="section-heading section-heading--compact">
          <span>{copy.testEyebrow}</span>
          <h2>{copy.testTitle}</h2>
        </div>
        <div class="test-grid">
          {arenaRubraTestAreas.map(([title, body]) => (
            <article>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section class="two-forms section-block">
      <Container>
        <div class="two-forms__grid">
          <div>
            <span class="eyebrow">{copy.formsEyebrow}</span>
            <h2>{copy.formsTitle}</h2>
          </div>
          <div class="two-forms__copy">
            <p>{arenaRubraUniverse.relationship}</p>
            <p>{copy.formsBody}</p>
          </div>
        </div>
        <ArenaRubraEcosystemLinks currentSlug="arena-rubra-board-game" locale={locale} />
      </Container>
    </section>

    <section class="cards-section section-block">
      <Container>
        <div class="cards-heading">
          <div>
            <span>{copy.cardsEyebrow}</span>
            <h2>{copy.cardsTitle}</h2>
          </div>
          <p>{copy.cardsBody}</p>
        </div>
        <div class="sample-cards">
          {sampleCards.map((card) => (
            <figure>
              <div class="sample-card__frame">
                <img src={card.src} alt={card.alt} width="760" height="1140" loading="lazy" decoding="async" />
              </div>
              <figcaption>
                <span>{card.label}</span>
                <strong>{card.name}</strong>
              </figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </section>

    {data.gallery.length > 0 && (
      <section class="tabletop-gallery section-block">
        <Container>
          <ProjectGallery items={data.gallery} locale={locale} />
        </Container>
      </section>
    )}

    <section class="status-section section-block">
      <Container>
        <div class="status-grid">
          <div>
            <span class="eyebrow">{copy.statusEyebrow}</span>
            <h2>{copy.statusTitle}</h2>
            <p>{copy.statusBody}</p>
          </div>
          <dl>
            {developmentStatus.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </Container>
    </section>

    {data.endcapImage && (
      <section class="tabletop-endcap">
        <Container>
          <figure>
            <img src={data.endcapImage} alt={data.endcapAlt ?? ''} width="1000" height="1500" loading="lazy" decoding="async" />
          </figure>
        </Container>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .tabletop-page {
    --tabletop-gold: #c89b58;
    --tabletop-bronze: #8e5b34;
    --tabletop-red: #9f382e;
    --tabletop-line: rgba(200,155,88,0.22);
    color: var(--color-text);
    background: #070707;
  }
  .section-block { padding-block: var(--section-space); }
  .tabletop-hero { padding-block: clamp(2rem,5vw,4.5rem) clamp(3rem,7vw,6rem); border-bottom: 1px solid var(--tabletop-line); background: #090806; }
  .tabletop-back { display: inline-flex; margin-bottom: clamp(2rem,4vw,3.5rem); color: var(--color-text-muted); font-family: var(--font-mono); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .tabletop-back:hover { color: var(--tabletop-gold); }
  .tabletop-hero__head { display: grid; gap: 2rem; align-items: end; margin-bottom: clamp(2rem,5vw,3.5rem); }
  .tabletop-hero__copy { display: grid; gap: 1.25rem; max-width: 58rem; }
  .tabletop-kicker { display: flex; flex-wrap: wrap; gap: .7rem 1.2rem; color: var(--tabletop-gold); font-family: var(--font-mono); font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .tabletop-kicker span:last-child { color: #d77360; }
  .tabletop-hero h1 { margin: 0; font-size: clamp(3.2rem,9vw,7.6rem); line-height: .87; letter-spacing: -.065em; }
  .tabletop-hero__copy > p { max-width: 52rem; margin: 0; color: var(--color-text-muted); font-size: clamp(1.08rem,1rem + .45vw,1.4rem); line-height: 1.68; }
  .tabletop-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
  .tabletop-action { padding: .82rem 1rem; border: 1px solid var(--tabletop-line); border-radius: var(--radius-sm); color: var(--color-text); font-family: var(--font-mono); font-size: .72rem; font-weight: 800; letter-spacing: .05em; text-decoration: none; text-transform: uppercase; }
  .tabletop-action:hover { border-color: var(--tabletop-gold); }
  .tabletop-action--primary { border-color: var(--tabletop-gold); color: #090806; background: var(--tabletop-gold); }
  .prototype-note { display: grid; gap: .7rem; max-width: 25rem; padding: 1.2rem; border: 1px solid var(--tabletop-line); background: #100d09; }
  .prototype-note > span, .eyebrow, .section-heading > span, .cards-heading span { color: var(--tabletop-gold); font-family: var(--font-mono); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .prototype-note strong { font-size: 1.15rem; }
  .prototype-note p { margin: 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.6; }
  .tabletop-hero__media { overflow: hidden; margin: 0; border: 1px solid var(--tabletop-line); border-radius: var(--radius-lg); background: #020202; }
  .tabletop-hero__media img { display: block; width: 100%; height: auto; }
  .tabletop-hero__media figcaption { padding: .7rem .9rem; color: var(--color-text-subtle); border-top: 1px solid var(--tabletop-line); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .03em; }
  .tabletop-facts { display: grid; gap: 1px; margin-top: 1rem; border: 1px solid var(--tabletop-line); background: var(--tabletop-line); }
  .tabletop-facts > div { display: grid; gap: .35rem; padding: 1rem; background: #0b0907; }
  .tabletop-facts span { color: var(--color-text-subtle); font-family: var(--font-mono); font-size: .66rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .tabletop-facts strong { color: #f4e7d3; font-size: 1rem; }

  .tabletop-intro { border-bottom: 1px solid var(--tabletop-line); background: #080706; }
  .intro-grid, .two-forms__grid { display: grid; gap: 2rem; }
  .intro-grid > div:first-child, .two-forms__grid > div:first-child { display: grid; align-content: start; gap: .8rem; }
  .intro-grid h2, .two-forms h2, .testing-copy h2, .status-grid h2 { margin: 0; font-size: clamp(2.2rem,5vw,4.8rem); line-height: .98; letter-spacing: -.05em; }
  .intro-copy, .two-forms__copy { display: grid; gap: 1rem; }
  .intro-copy p, .two-forms__copy p, .status-grid > div > p { margin: 0; color: var(--color-text-muted); font-size: 1rem; line-height: 1.78; }
  .intro-copy p:first-child { color: var(--color-text); font-size: 1.08rem; }

  .tabletop-system { border-bottom: 1px solid var(--tabletop-line); background: #0b0907; }
  .section-heading { display: grid; gap: .7rem; max-width: 58rem; margin-bottom: 2rem; }
  .section-heading h2, .cards-heading h2 { margin: 0; font-size: clamp(2.2rem,5vw,4.6rem); line-height: .98; letter-spacing: -.05em; }
  .section-heading--compact h2 { max-width: 17ch; }
  .pillar-grid { display: grid; gap: 1rem; }
  .pillar-grid article { display: grid; gap: .75rem; padding: 1.2rem; border: 1px solid var(--tabletop-line); background: #0f0c09; }
  .pillar-grid article > span { color: #6f5940; font-family: var(--font-mono); font-size: .7rem; font-weight: 800; }
  .pillar-grid h3 { margin: 0; color: #f1d5a4; font-size: 1.1rem; letter-spacing: .08em; }
  .pillar-grid strong { font-size: 1rem; }
  .pillar-grid p { margin: 0; color: var(--color-text-muted); line-height: 1.7; }

  .match-flow { border-bottom: 1px solid var(--tabletop-line); background: #070707; }
  .flow-grid { display: grid; gap: 1px; border: 1px solid var(--tabletop-line); background: var(--tabletop-line); }
  .flow-grid article { display: grid; gap: .5rem; padding: 1rem; background: #0d0b08; }
  .flow-grid article > span { color: #6f5940; font-family: var(--font-mono); font-size: .66rem; font-weight: 800; }
  .flow-grid h3 { margin: 0; color: #f1d5a4; font-family: var(--font-mono); font-size: .82rem; letter-spacing: .08em; }
  .flow-grid p { margin: 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.55; }

  .systems-section { border-bottom: 1px solid var(--tabletop-line); background: #0b0907; }
  .systems-grid { display: grid; gap: .8rem; }
  .systems-grid article { display: grid; gap: .65rem; padding: 1rem; border: 1px solid #2a2721; background: #0c0b09; }
  .systems-grid h3, .test-grid h3 { margin: 0; color: #f1d5a4; font-size: 1rem; }
  .systems-grid p, .test-grid p { margin: 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.65; }

  .tabletop-story { background: #070707; }
  .tabletop-story__grid { display: grid; gap: 3rem; }
  .tabletop-story__aside { display: grid; align-content: start; gap: .8rem; padding: 1.15rem; border: 1px solid var(--tabletop-line); background: #0d0b08; }
  .tabletop-story__aside span { color: var(--tabletop-gold); font-family: var(--font-mono); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .tabletop-story__aside p { margin: 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.65; }
  :global(.tabletop-prose) { max-width: 53rem; }
  :global(.tabletop-prose h2) { margin: 0 0 1.2rem; font-size: clamp(2rem,4vw,3.5rem); line-height: 1; letter-spacing: -.045em; }
  :global(.tabletop-prose h2:not(:first-child)) { margin-top: 4.2rem; }
  :global(.tabletop-prose p) { margin: 0 0 1.3rem; color: var(--color-text-muted); font-size: clamp(1rem,.96rem + .15vw,1.08rem); line-height: 1.82; }
  :global(.tabletop-prose strong) { color: #f3ddbb; }

  .faction-section { border-top: 1px solid var(--tabletop-line); border-bottom: 1px solid var(--tabletop-line); background: #080706; }

  .testing-section { border-bottom: 1px solid var(--tabletop-line); background: #0d0a08; }
  .testing-hero { display: grid; gap: 2rem; align-items: center; }
  .testing-stat { display: grid; justify-items: start; gap: .2rem; }
  .testing-stat strong { color: #f1d5a4; font-size: clamp(4.8rem,16vw,10rem); line-height: .78; letter-spacing: -.08em; }
  .testing-stat span { color: var(--color-text-subtle); font-family: var(--font-mono); font-size: .72rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .testing-copy { display: grid; gap: 1rem; }
  .testing-copy p { margin: 0; color: var(--color-text-muted); line-height: 1.75; }
  .testing-copy blockquote { margin: 0; padding-left: 1rem; border-left: 2px solid var(--tabletop-gold); color: var(--color-text); font-family: Georgia, 'Times New Roman', serif; font-size: 1.15rem; line-height: 1.6; }
  .testing-copy code { width: fit-content; padding: .55rem .7rem; color: #f1d5a4; background: #090806; border: 1px solid var(--tabletop-line); font-family: var(--font-mono); font-size: .75rem; }
  .testing-strapline { margin: 2rem 0 0; padding-top: 1rem; border-top: 1px solid var(--tabletop-line); color: var(--color-text-subtle); font-family: var(--font-mono); font-size: .68rem; line-height: 1.7; letter-spacing: .04em; text-transform: uppercase; }

  .test-areas { border-bottom: 1px solid var(--tabletop-line); background: #080706; }
  .test-grid { display: grid; gap: .8rem; }
  .test-grid article { display: grid; gap: .55rem; padding: 1rem; border: 1px solid #2a2721; background: #0d0d0c; }

  .two-forms { border-bottom: 1px solid var(--tabletop-line); background: #0b0907; }
  .two-forms__grid { margin-bottom: 2rem; }

  .cards-section { background: #0a0907; }
  .cards-heading { display: grid; gap: 1.2rem; margin-bottom: 2rem; }
  .cards-heading > div { display: grid; gap: .7rem; }
  .cards-heading > p { max-width: 40rem; margin: 0; color: var(--color-text-muted); line-height: 1.7; }
  .sample-cards { display: grid; gap: 1rem; }
  .sample-cards figure { display: grid; gap: .75rem; margin: 0; min-width: 0; }
  .sample-card__frame { display: grid; place-items: center; min-height: 0; padding: .5rem; border: 1px solid var(--tabletop-line); background: #050403; }
  .sample-card__frame img { display: block; width: 100%; height: auto; max-height: 48rem; object-fit: contain; }
  .sample-cards figcaption { display: grid; gap: .25rem; }
  .sample-cards figcaption span { color: var(--color-text-subtle); font-family: var(--font-mono); font-size: .66rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .sample-cards figcaption strong { font-size: 1rem; }

  .tabletop-gallery { border-top: 1px solid var(--tabletop-line); background: #050504; }
  .tabletop-gallery :global(.project-gallery__eyebrow) { color: var(--tabletop-gold); }
  .tabletop-gallery :global(.gallery-card__open:hover) { border-color: var(--tabletop-gold); }

  .status-section { border-top: 1px solid var(--tabletop-line); background: #0d0a08; }
  .status-grid { display: grid; gap: 2rem; }
  .status-grid > div:first-child { display: grid; gap: .9rem; align-content: start; }
  .status-grid dl { display: grid; gap: 1px; margin: 0; border: 1px solid var(--tabletop-line); background: var(--tabletop-line); }
  .status-grid dl > div { display: grid; grid-template-columns: minmax(8rem,.65fr) minmax(0,1fr); gap: 1rem; padding: .85rem 1rem; background: #0b0907; }
  .status-grid dt { color: var(--color-text-subtle); font-family: var(--font-mono); font-size: .65rem; font-weight: 800; letter-spacing: .075em; text-transform: uppercase; }
  .status-grid dd { margin: 0; color: var(--color-text); font-size: .9rem; }

  .tabletop-endcap { padding-block: 0 var(--section-space); background: #0d0a08; }
  .tabletop-endcap figure { overflow: hidden; width: min(54rem,100%); margin: 0 auto; border: 1px solid var(--tabletop-line); background: #020202; }
  .tabletop-endcap img { display: block; width: 100%; height: auto; }

  @media (min-width: 40rem) {
    .tabletop-facts { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .pillar-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .flow-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .systems-grid, .test-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .sample-cards { grid-template-columns: repeat(3,minmax(0,1fr)); align-items: start; }
  }
  @media (min-width: 60rem) {
    .tabletop-hero__head { grid-template-columns: minmax(0,1fr) 24rem; gap: 4rem; }
    .tabletop-facts { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .intro-grid, .two-forms__grid, .status-grid { grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: 4rem; align-items: start; }
    .flow-grid { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .systems-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .systems-grid article:last-child { grid-column: span 2; }
    .tabletop-story__grid { grid-template-columns: 18rem minmax(0,1fr); gap: clamp(3rem,7vw,6rem); align-items: start; }
    .tabletop-story__aside { position: sticky; top: 6.5rem; }
    .testing-hero { grid-template-columns: minmax(18rem,.65fr) minmax(0,1.35fr); gap: 4rem; }
    .test-grid { grid-template-columns: repeat(4,minmax(0,1fr)); }
    .cards-heading { grid-template-columns: minmax(0,1fr) minmax(20rem,.7fr); align-items: end; gap: 3rem; }
  }
</style>
